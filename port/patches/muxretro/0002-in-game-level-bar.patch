--- /dev/null
+++ b/frontend/retro/input/level_osd.c
@@ -0,0 +1,441 @@
+#include <unistd.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <SDL2/SDL.h>
+#include <SDL2/SDL_image.h>
+#include <common/base/options.h>
+#include <common/config/config.h>
+#include <common/display/theme.h>
+#include <common/platform/device.h>
+#include <common/platform/display.h>
+#include <common/platform/sysinfo.h>
+#include <common/runtime/init.h>
+#include <common/storage/fileio.h>
+#include <common/ui/common.h>
+#include "../core/muxretro.h"
+#include "level_osd.h"
+
+/* Upstream hides the panel at the second status tick after the last change
+ * (TIMER_STATUS 1024 ms, progress_onscreen), then fades it over 200 ms. */
+#define OSD_HOLD_MS 1500
+#define OSD_FADE_MS 200
+
+static enum level_osd_kind osd_kind;
+static int osd_percent;
+static uint32_t osd_shown;
+static int osd_registered;
+static SDL_Texture *glyphs[2][4];
+static int glyph_w[2][4], glyph_h[2][4];
+static int glyph_failed[2][4];
+
+static int glyph_level(const int percent) {
+    return percent > 70 ? 3 : percent > 35 ? 2 : percent > 0 ? 1 : 0;
+}
+
+/* The theme's SVG glyph at libui's default size (3/4 of a list item),
+ * recoloured to the bar icon colour as LVGL's img_recolor does (ARGB8888;
+ * shared with level_osd_export). */
+static SDL_Surface *glyph_surface(const enum level_osd_kind kind, const int level) {
+    char name[16], path[MAX_BUFFER_SIZE], embed[MAX_BUFFER_SIZE];
+    snprintf(name, sizeof(name), "%s_%d", kind == level_osd_volume ? "volume" : "bright", level);
+    if (!generate_image_embed(mux_dim, "bar", name, path, sizeof(path), embed, sizeof(embed))) return NULL;
+
+    int size = theme.mux.item.height * 3 / 4;
+    if (size <= 0 || size > theme.bar.panel_height) size = theme.bar.panel_height - 8;
+    if (size <= 0) return NULL;
+
+    SDL_RWops *rw = SDL_RWFromFile(path, "rb");
+    if (!rw) return NULL;
+    SDL_Surface *loaded = IMG_isSVG(rw) ? IMG_LoadSizedSVG_RW(rw, size, size) : IMG_Load_RW(rw, 0);
+    SDL_RWclose(rw);
+    if (!loaded) return NULL;
+
+    SDL_Surface *s = SDL_ConvertSurfaceFormat(loaded, SDL_PIXELFORMAT_ARGB8888, 0);
+    SDL_FreeSurface(loaded);
+    if (!s) return NULL;
+
+    const uint32_t rgb = theme.bar.icon & 0xFFFFFFu;
+    const int opa = theme.bar.icon_alpha;
+    if (SDL_LockSurface(s) == 0) {
+        for (int y = 0; y < s->h; y++) {
+            uint32_t *row = (uint32_t *) ((uint8_t *) s->pixels + y * s->pitch);
+            for (int x = 0; x < s->w; x++) {
+                const uint32_t a = (row[x] >> 24) * (uint32_t) opa / 255u;
+                row[x] = a << 24 | rgb;
+            }
+        }
+        SDL_UnlockSurface(s);
+    }
+    return s;
+}
+
+/* Loaded once per kind and level, on first use. */
+static SDL_Texture *glyph(SDL_Renderer *renderer, const enum level_osd_kind kind, const int level) {
+    if (glyphs[kind][level] || glyph_failed[kind][level]) return glyphs[kind][level];
+    glyph_failed[kind][level] = 1;
+
+    SDL_Surface *s = glyph_surface(kind, level);
+    if (!s) return NULL;
+
+    SDL_Texture *t = SDL_CreateTextureFromSurface(renderer, s);
+    glyph_w[kind][level] = s->w;
+    glyph_h[kind][level] = s->h;
+    SDL_FreeSurface(s);
+    if (!t) return NULL;
+
+    SDL_SetTextureBlendMode(t, SDL_BLENDMODE_BLEND);
+    glyph_failed[kind][level] = 0;
+    glyphs[kind][level] = t;
+    return t;
+}
+
+static void over(uint8_t *px, const int stride, const int x0, const int y0, const int w, const int h, const uint32_t rgb,
+                 const int alpha, const uint32_t *src, const int src_pitch) {
+    for (int y = 0; y < h; y++) {
+        for (int x = 0; x < w; x++) {
+            uint32_t c = rgb;
+            int sa = alpha;
+            if (src) {
+                const uint32_t p = src[y * src_pitch + x];
+                c = p & 0xFFFFFFu;
+                sa = (int) (p >> 24) * alpha / 255;
+            }
+            if (sa <= 0) continue;
+            uint8_t *d = px + (size_t) (y0 + y) * stride + (size_t) (x0 + x) * 4;
+            const int da = d[3];
+            const int oa = sa + da * (255 - sa) / 255;
+            if (oa <= 0) continue;
+            const int sc[3] = {(int) (c >> 16 & 0xFF), (int) (c >> 8 & 0xFF), (int) (c & 0xFF)};
+            for (int i = 0; i < 3; i++) d[i] = (uint8_t) ((sc[i] * sa + d[i] * da * (255 - sa) / 255) / oa);
+            d[3] = (uint8_t) oa;
+        }
+    }
+}
+
+/* Rounded shapes as LVGL draws the menu's bar (lv_obj radius, 2 px border,
+ * lv_bar background and indicator radius): coverage of a pixel by a rounded
+ * rectangle (anti-aliased over one pixel), radius clamped to half the short
+ * side as LVGL does. */
+static float round_cov(const float px, const float py, const float w, const float h, float r) {
+    if (w <= 0 || h <= 0) return 0.0f;
+    if (r > w / 2) r = w / 2;
+    if (r > h / 2) r = h / 2;
+    if (r < 0) r = 0;
+    const float cx = px < r ? r : px > w - r ? w - r : px;
+    const float cy = py < r ? r : py > h - r ? h - r : py;
+    const float dx = px - cx, dy = py - cy;
+    float d;
+    if (dx == 0 && dy == 0) {
+        const float ex = px < w - px ? px : w - px, ey = py < h - py ? py : h - py;
+        d = -(ex < ey ? ex : ey);
+    } else {
+        d = SDL_sqrtf(dx * dx + dy * dy) - r;
+    }
+    const float c = 0.5f - d;
+    return c < 0 ? 0.0f : c > 1 ? 1.0f : c;
+}
+
+/* RGBA8 (straight alpha) w x h: a rounded rectangle filled with BG and,
+ * when BORDER_W > 0, an inner border ring of BORDER_W pixels. */
+static uint8_t *round_rect(const int w, const int h, const int r, const uint32_t bg, const int bg_a,
+                           const uint32_t border, const int border_a, const int border_w) {
+    uint8_t *px = calloc((size_t) w * h, 4);
+    if (!px) return NULL;
+    for (int y = 0; y < h; y++) {
+        for (int x = 0; x < w; x++) {
+            const float fx = x + 0.5f, fy = y + 0.5f;
+            const float outer = round_cov(fx, fy, (float) w, (float) h, (float) r);
+            if (outer <= 0) continue;
+            const int a = (int) (outer * bg_a + 0.5f);
+            if (a > 0) over(px, w * 4, x, y, 1, 1, bg, a, NULL, 0);
+            if (border_w > 0 && border_a > 0) {
+                const float inner = round_cov(fx - border_w, fy - border_w, (float) (w - 2 * border_w),
+                                              (float) (h - 2 * border_w), (float) (r - border_w));
+                const float ring = outer - inner;
+                const int ba = (int) (ring * border_a + 0.5f);
+                if (ba > 0) over(px, w * 4, x, y, 1, 1, border, ba, NULL, 0);
+            }
+        }
+    }
+    return px;
+}
+
+static int bar_radius(void) {
+    int r = theme.bar.progress_radius, bh = theme.bar.progress_height, bw = theme.bar.progress_width;
+    if (r > bh / 2) r = bh / 2;
+    if (r > bw / 2) r = bw / 2;
+    return r < 0 ? 0 : r;
+}
+
+static uint8_t *panel_pixels(void) {
+    return round_rect(theme.bar.panel_width, theme.bar.panel_height, theme.bar.panel_border_radius,
+                      theme.bar.panel_background & 0xFFFFFFu, theme.bar.panel_background_alpha,
+                      theme.bar.panel_border & 0xFFFFFFu, theme.bar.panel_border_alpha, 2);
+}
+
+static uint8_t *progress_pixels(const int active) {
+    return round_rect(theme.bar.progress_width, theme.bar.progress_height, bar_radius(),
+                      (active ? theme.bar.progress_active_background : theme.bar.progress_main_background) & 0xFFFFFFu,
+                      active ? theme.bar.progress_active_background_alpha : theme.bar.progress_main_background_alpha, 0,
+                      0, 0);
+}
+
+static SDL_Texture *shape_tex[3]; /* panel, track, fill */
+
+static SDL_Texture *shape(SDL_Renderer *renderer, const int i) {
+    if (shape_tex[i]) return shape_tex[i];
+    const int w = i ? theme.bar.progress_width : theme.bar.panel_width;
+    const int h = i ? theme.bar.progress_height : theme.bar.panel_height;
+    if (w <= 0 || h <= 0) return NULL;
+    uint8_t *px = i ? progress_pixels(i == 2) : panel_pixels();
+    if (!px) return NULL;
+    SDL_Texture *t = SDL_CreateTexture(renderer, SDL_PIXELFORMAT_ABGR8888, SDL_TEXTUREACCESS_STATIC, w, h);
+    if (t && SDL_UpdateTexture(t, NULL, px, w * 4) == 0) {
+        SDL_SetTextureBlendMode(t, SDL_BLENDMODE_BLEND);
+    } else if (t) {
+        SDL_DestroyTexture(t);
+        t = NULL;
+    }
+    free(px);
+    shape_tex[i] = t;
+    return t;
+}
+
+/* The indicator of FILL_W pixels from the full-width rounded fill image:
+ * left cap, stretched middle column, right cap (LVGL's indicator radius);
+ * narrower than both caps, the left part of the image (LVGL masks it with
+ * the background's shape). Rectangles: SRC within the image, DST offsets
+ * from the bar's left edge; returns the count (0..3). */
+static int fill_slices(const int bw, const int fill_w, const int r, SDL_Rect src[3], SDL_Rect dst[3], const int bh) {
+    int n = 0;
+    if (fill_w <= 0) return 0;
+    if (fill_w < 2 * r) {
+        src[n] = (SDL_Rect) {0, 0, fill_w, bh};
+        dst[n++] = (SDL_Rect) {0, 0, fill_w, bh};
+        return n;
+    }
+    if (r > 0) {
+        src[n] = (SDL_Rect) {0, 0, r, bh};
+        dst[n++] = (SDL_Rect) {0, 0, r, bh};
+    }
+    if (fill_w - 2 * r > 0) {
+        src[n] = (SDL_Rect) {r < bw ? r : bw - 1, 0, 1, bh};
+        dst[n++] = (SDL_Rect) {r, 0, fill_w - 2 * r, bh};
+    }
+    if (r > 0) {
+        src[n] = (SDL_Rect) {bw - r, 0, r, bh};
+        dst[n++] = (SDL_Rect) {fill_w - r, 0, r, bh};
+    }
+    return n;
+}
+
+static void fill(SDL_Renderer *renderer, const SDL_Rect *r, const uint32_t rgb, const int alpha) {
+    SDL_SetRenderDrawColor(renderer, rgb >> 16 & 0xFF, rgb >> 8 & 0xFF, rgb & 0xFF, (uint8_t) alpha);
+    SDL_RenderFillRect(renderer, r);
+}
+
+static void osd_draw(SDL_Renderer *renderer) {
+    const uint32_t age = SDL_GetTicks() - osd_shown;
+    if (age >= OSD_HOLD_MS + OSD_FADE_MS || pause_menu_is_active()) {
+        level_osd_hide();
+        return;
+    }
+    const int fade = age <= OSD_HOLD_MS ? 255 : 255 - (int) ((age - OSD_HOLD_MS) * 255 / OSD_FADE_MS);
+#define A(x) ((int) (x) * fade / 255)
+
+    const int pw = theme.bar.panel_width, ph = theme.bar.panel_height;
+    const SDL_Rect panel = {(device.mux.width - pw) / 2, theme.bar.y_pos, pw, ph};
+
+    SDL_BlendMode old_mode;
+    SDL_GetRenderDrawBlendMode(renderer, &old_mode);
+    SDL_SetRenderDrawBlendMode(renderer, SDL_BLENDMODE_BLEND);
+
+    /* v1.1.1: the menu's rounded panel (radius, 2 px border) */
+    SDL_Texture *pt = shape(renderer, 0);
+    if (pt) {
+        SDL_SetTextureAlphaMod(pt, (uint8_t) fade);
+        SDL_RenderCopy(renderer, pt, NULL, &panel);
+    }
+
+    /* LVGL flex row, space evenly: icon, then the bar. */
+    const int level = glyph_level(osd_percent);
+    SDL_Texture *icon = glyph(renderer, osd_kind, level);
+    const int iw = icon ? glyph_w[osd_kind][level] : 0, ih = icon ? glyph_h[osd_kind][level] : 0;
+    const int bw = theme.bar.progress_width, bh = theme.bar.progress_height;
+    int gap = (pw - iw - bw) / 3;
+    if (gap < 0) gap = 0;
+
+    if (icon) {
+        const SDL_Rect dst = {panel.x + gap, panel.y + (ph - ih) / 2, iw, ih};
+        SDL_SetTextureAlphaMod(icon, (uint8_t) fade);
+        SDL_RenderCopy(renderer, icon, NULL, &dst);
+    }
+
+    const SDL_Rect bar = {panel.x + gap + iw + gap, panel.y + (ph - bh) / 2, bw, bh};
+    const int pct = osd_percent < 0 ? 0 : osd_percent > 100 ? 100 : osd_percent;
+    SDL_Texture *tt = shape(renderer, 1), *ft = shape(renderer, 2);
+    if (tt && ft) {
+        /* v1.1.1: the menu's rounded track and indicator */
+        SDL_SetTextureAlphaMod(tt, (uint8_t) fade);
+        SDL_RenderCopy(renderer, tt, NULL, &bar);
+        SDL_Rect src[3], dst[3];
+        const int n = fill_slices(bw, bw * pct / 100, bar_radius(), src, dst, bh);
+        SDL_SetTextureAlphaMod(ft, (uint8_t) fade);
+        for (int i = 0; i < n; i++) {
+            const SDL_Rect d = {bar.x + dst[i].x, bar.y + dst[i].y, dst[i].w, dst[i].h};
+            SDL_RenderCopy(renderer, ft, &src[i], &d);
+        }
+    } else {
+        fill(renderer, &bar, theme.bar.progress_main_background, A(theme.bar.progress_main_background_alpha));
+        const SDL_Rect on = {bar.x, bar.y, bw * pct / 100, bh};
+        if (on.w > 0)
+            fill(renderer, &on, theme.bar.progress_active_background, A(theme.bar.progress_active_background_alpha));
+    }
+#undef A
+
+    SDL_SetRenderDrawBlendMode(renderer, old_mode);
+}
+
+void level_osd_show(const enum level_osd_kind kind, const int percent) {
+    osd_kind = kind;
+    osd_percent = percent;
+    osd_shown = SDL_GetTicks();
+    if (!osd_registered) {
+        display_set_video_overlay(osd_draw);
+        osd_registered = 1;
+    }
+}
+
+void level_osd_hide(void) {
+    if (!osd_registered) return;
+    display_clear_video_overlay();
+    osd_registered = 0;
+}
+
+static int woke_recently(void) {
+    return access(RUN_PATH "recent_wake", F_OK) == 0;
+}
+
+int level_osd_tick(void) {
+    if (pause_menu_is_active()) return 0;
+
+    static unsigned volume_seen = 1, brightness_seen = 1;
+    if (brightness_config_changes != brightness_seen) {
+        brightness_seen = brightness_config_changes;
+        const int v = read_line_int_from(CONF_CONFIG_PATH "settings/general/brightness", 1);
+        if (v >= 0 && v <= device.screen.bright && v != current_brightness) {
+            current_brightness = v;
+            if (!woke_recently()) level_osd_show(level_osd_brightness, brightness_to_percent(v));
+        }
+    }
+    if (volume_config_changes != volume_seen) {
+        volume_seen = volume_config_changes;
+        const int v = read_line_int_from(CONF_CONFIG_PATH "settings/general/volume", 1);
+        /* device.c clamps device.audio.max to 100, but Audio overdrive
+         * (tweak.sh: device audio/max 200) allows saved volumes up to 200,
+         * and volume_to_percent scales by 200: accept them, or the bar
+         * stops at 50 % (M4f T3). */
+        const int max = config.settings.advanced.overdrive ? 200 : device.audio.max;
+        if (v >= 0 && v <= max && v != current_volume) {
+            current_volume = v;
+            if (!woke_recently()) level_osd_show(level_osd_volume, volume_to_percent(v));
+        }
+    }
+    return 1;
+}
+
+int level_osd_key(const enum level_osd_kind kind) {
+    if (pause_menu_is_active()) return 0;
+    level_osd_show(kind, kind == level_osd_volume ? volume_to_percent(current_volume)
+                                                  : brightness_to_percent(current_brightness));
+    return 1;
+}
+
+/* ---- muxretro --level-assets DIR (v1.1.1) -------------------------------
+ * The bar as drawn above, for programs muxretro does not run: muos-levelbar.so
+ * (preloaded into ports, applications and standalone emulators) draws these
+ * files over their frames. Per kind and glyph level, DIR/<volume|bright>_N.rgba
+ * is the panel (rounded background and 2 px border, glyph; RGBA8, straight
+ * alpha, the layers composited "over" as SDL blends them), DIR/track.rgba
+ * and DIR/fill.rgba the rounded progress bar's background and full-width
+ * indicator (drawn in slices, fill_slices), and DIR/levelbar.conf the theme
+ * size, the panel position, the progress bar (x per image), its colours and
+ * radius. */
+int level_osd_export(const char *dir) {
+    const int pw = theme.bar.panel_width, ph = theme.bar.panel_height;
+    const int bw = theme.bar.progress_width, bh = theme.bar.progress_height;
+    if (pw <= 4 || ph <= 4 || pw > 4096 || ph > 1024) return 0;
+    mkdir(dir, 0755);
+
+    char path[MAX_BUFFER_SIZE], conf[4096];
+    int n = snprintf(conf, sizeof(conf), "mux %d %d\npanel %d %d %d %d\nbar %d %d\nmain %06X %d\nactive %06X %d\n",
+                     device.mux.width, device.mux.height, (device.mux.width - pw) / 2, theme.bar.y_pos, pw, ph, bw, bh,
+                     theme.bar.progress_main_background & 0xFFFFFFu, theme.bar.progress_main_background_alpha,
+                     theme.bar.progress_active_background & 0xFFFFFFu, theme.bar.progress_active_background_alpha);
+    uint8_t *px = malloc((size_t) pw * ph * 4), *base = panel_pixels();
+    if (!px || !base) {
+        free(px);
+        free(base);
+        return 0;
+    }
+    /* the rounded track and the full-width rounded fill (drawn in slices) */
+    for (int i = 1; i <= 2; i++) {
+        uint8_t *bar = bw > 0 && bh > 0 ? progress_pixels(i == 2) : NULL;
+        snprintf(path, sizeof(path), "%s/%s.rgba", dir, i == 2 ? "fill" : "track");
+        FILE *f = bar ? fopen(path, "wb") : NULL;
+        const int ok = f && fwrite(bar, 1, (size_t) bw * bh * 4, f) == (size_t) bw * bh * 4;
+        if (f) fclose(f);
+        free(bar);
+        if (!ok) {
+            free(px);
+            free(base);
+            return 0;
+        }
+    }
+    if (n > 0 && (size_t) n < sizeof(conf)) n += snprintf(conf + n, sizeof(conf) - (size_t) n, "radius %d\n", bar_radius());
+    for (int kind = 0; kind < 2; kind++) {
+        for (int level = 0; level < 4; level++) {
+            memcpy(px, base, (size_t) pw * ph * 4);
+            SDL_Surface *g = glyph_surface((enum level_osd_kind) kind, level);
+            int iw = 0;
+            int gap = (pw - bw) / 3;
+            if (g) {
+                iw = g->w;
+                gap = (pw - iw - bw) / 3;
+                if (gap < 0) gap = 0;
+                const int gx = gap, gy = (ph - g->h) / 2;
+                const int w = gx + g->w > pw ? pw - gx : g->w, h = gy + g->h > ph ? ph - gy : g->h;
+                if (gy >= 0 && w > 0 && h > 0 && SDL_LockSurface(g) == 0) {
+                    over(px, pw * 4, gx, gy, w, h, 0, 255, (const uint32_t *) g->pixels, g->pitch / 4);
+                    SDL_UnlockSurface(g);
+                }
+                SDL_FreeSurface(g);
+            }
+            if (gap < 0) gap = 0;
+            snprintf(path, sizeof(path), "%s/%s_%d.rgba", dir, kind ? "bright" : "volume", level);
+            FILE *f = fopen(path, "wb");
+            const int ok = f && fwrite(px, 1, (size_t) pw * ph * 4, f) == (size_t) pw * ph * 4;
+            if (f) fclose(f);
+            if (!ok) {
+                free(px);
+                free(base);
+                return 0;
+            }
+            if (n > 0 && (size_t) n < sizeof(conf))
+                n += snprintf(conf + n, sizeof(conf) - (size_t) n, "image %d %d %d\n", kind, level, gap + iw + gap);
+        }
+    }
+    free(px);
+    free(base);
+    if (n <= 0 || (size_t) n >= sizeof(conf)) return 0;
+    char tmp[MAX_BUFFER_SIZE + 8];
+    snprintf(path, sizeof(path), "%s/levelbar.conf", dir);
+    snprintf(tmp, sizeof(tmp), "%s.tmp", path);
+    FILE *f = fopen(tmp, "w");
+    if (!f) return 0;
+    const int ok = fputs(conf, f) >= 0;
+    if (fclose(f) != 0 || !ok) return 0;
+    return rename(tmp, path) == 0;
+}
--- /dev/null
+++ b/frontend/retro/input/level_osd.h
@@ -0,0 +1,27 @@
+#pragma once
+
+/* muOS R35S port: in-game volume/brightness level bar drawn by muxretro
+ * itself (display video overlay hook: SDL fills plus a cached glyph
+ * texture) instead of libui's LVGL panel. The LVGL panel makes the UI layer
+ * visible, so every frame goes through lv_refr_now and a UI render target,
+ * and each level change re-renders the SVG glyph: one or two missed vsyncs
+ * per change on the RK3326 (M3d step 3). The pause menu keeps upstream's. */
+
+enum level_osd_kind { level_osd_volume = 0, level_osd_brightness = 1 };
+
+void level_osd_show(enum level_osd_kind kind, int percent);
+
+void level_osd_hide(void);
+
+/* In game (pause menu closed): read the level files on a change notice and
+ * show the bar. Returns 0 when the pause menu is open (caller runs upstream's
+ * ui_common_progress_tick). */
+int level_osd_tick(void);
+
+/* A volume/brightness key in game: show the current level (as upstream's
+ * ui_common_handle_*). Returns 0 when the pause menu is open. */
+int level_osd_key(enum level_osd_kind kind);
+
+/* muxretro --level-assets DIR: the bar of the active theme as files for
+ * muos-levelbar.so (ports, applications, standalone emulators). 1 = ok. */
+int level_osd_export(const char *dir);
--- a/frontend/retro/input/hotkeys.c
+++ b/frontend/retro/input/hotkeys.c
@@ -16,6 +16,7 @@
 #include "../core/phase4-diagnostic-exit.h"
 #include "../core/muxretro.h"
 #include "nav_repeat.h"
+#include "level_osd.h"
