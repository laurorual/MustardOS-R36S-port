SDL2: permit the checked GBM 10.4 API in the R35S candidate

SPDX-License-Identifier: Zlib
The port controller first compiles/links every mandatory GBM entry point
used by SDL 2.30.12 KMSDRM. Optional modifier/plane APIs remain optional.
Do not change gbm.pc or claim Mesa 11.1; runtime remains a separate gate.

--- a/configure.ac
+++ b/configure.ac
@@ -2407,7 +2407,7 @@
         video_kmsdrm=no
 
         PKG_CHECK_MODULES([LIBDRM], [libdrm >= 1.4.82], libdrm_avail=yes, libdrm_avail=no)
-        PKG_CHECK_MODULES([LIBGBM], [gbm >= 11.1.0], libgbm_avail=yes, libgbm_avail=no)
+        PKG_CHECK_MODULES([LIBGBM], [gbm >= 10.4.0], libgbm_avail=yes, libgbm_avail=no)
 
         if test x$libdrm_avail = xyes -a x$libgbm_avail = xyes; then
             video_kmsdrm=yes
--- a/configure
+++ b/configure
@@ -25658,19 +25658,19 @@
 fi
 
