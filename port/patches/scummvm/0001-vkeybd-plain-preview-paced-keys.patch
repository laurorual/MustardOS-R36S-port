+	/**
+	 * Delivers the submitted keys one at a time, spaced in time: engines
+	 * that keep only the last key per game tick (SCUMM: _keyPressed)
+	 * would otherwise receive just the last letter of a typed name.
+	 * Owned by the event dispatcher (registered with autoFree).
+	 */
+	class PacedKeySource : public ArtificialEventSource {
+		uint32 _next;
+	public:
+		PacedKeySource() : _next(0) {}
+		bool pollEvent(Event &ev) override;
+	};
