+
+bool VirtualKeyboard::PacedKeySource::pollEvent(Event &ev) {
+	if (_artificialEventQueue.empty())
+		return false;
+	uint32 now = g_system->getMillis();
+	if ((int32)(now - _next) < 0)
+		return false;
+	ev = _artificialEventQueue.pop();
+	// Key down, then key up 60 ms later, the next key 60 ms after that:
+	// longer than a SCUMM game tick, so every letter is seen.
+	_next = now + 60;
+	return true;
 }
 
