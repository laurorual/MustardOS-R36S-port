+        play_sound(snd_error);
+        return;
+    }
+
     switch (entry->action) {
         case menu_general:
             if (is_ksk(*entry->kiosk_flag)) {
@@ -184,6 +293,7 @@
                                   {ui_lbl_nav_b, lang.generic.back, 0},
                                   {NULL, NULL, 0}});
 
+    lv_obj_set_user_data(ui_lbl_radio_connect, "radio");
 #define CONNECT(NAME, UDATA) lv_obj_set_user_data(ui_lbl_##NAME##_connect, UDATA);
     CONNECT_ELEMENTS
 #undef CONNECT
@@ -209,7 +319,10 @@
 
     init_dropdown_settings();
 
-    init_timer(ui_gen_refresh_task, NULL);
+    radio_shown_available = radio_shown_enabled = -1;
+    radio_refresh();
+    radio_polled_ms = lv_tick_get();
+    init_timer(connect_refresh_task, NULL);
 
     mux_input_options input_opts = {
         .swap_axis = theme.misc.navigation_type == 1,
