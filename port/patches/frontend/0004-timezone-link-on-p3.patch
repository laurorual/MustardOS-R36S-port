From: muOS R35S port
Subject: [PATCH] 0004-timezone-link-on-p3

SPDX-License-Identifier: GPL-3.0
---
--- a/frontend/module/muxtimezone.c
+++ b/frontend/module/muxtimezone.c
@@ -1,4 +1,12 @@
 #include "muxshare.h"
+
+/* R35S port: the root is read-only and the user partition may be exFAT or
+   FAT32 (no symlinks). /etc/localtime is a fixed link to PORT_RUN_TIME, a
+   link in /run; the chosen zone is kept as text in PORT_LOCAL_TIME (an older
+   card has a link there), and muos-clock zone recreates the /run link from
+   it at boot (UTC on a new card). */
+#define PORT_LOCAL_TIME CONF_CONFIG_PATH "localtime"
+#define PORT_RUN_TIME "/run/muos/localtime"
 #include <common/ui/orientation.h>
 
 #define ZONE_REGION_OTHER "Other"
@@ -279,8 +287,10 @@
     char zone_group[MAX_BUFFER_SIZE];
     snprintf(zone_group, sizeof(zone_group), "/usr/share/zoneinfo/%s", full_zone);
 
-    unlink(LOCAL_TIME);
-    if (symlink(zone_group, LOCAL_TIME) != 0) {
+    unlink(PORT_LOCAL_TIME);
+    write_text_to_file(PORT_LOCAL_TIME, "w", CHAR, zone_group);
+    unlink(PORT_RUN_TIME);
+    if (symlink(zone_group, PORT_RUN_TIME) != 0) {
         LOG_ERROR(mux_module, "Failed to timezone symlink");
     }
 
--- a/frontend/module/muxrtc.c
+++ b/frontend/module/muxrtc.c
@@ -1,4 +1,12 @@
 #include "muxshare.h"
+
+/* R35S port: the root is read-only and the user partition may be exFAT or
+   FAT32 (no symlinks). /etc/localtime is a fixed link to PORT_RUN_TIME, a
+   link in /run; the chosen zone is kept as text in PORT_LOCAL_TIME (an older
+   card has a link there), and muos-clock zone recreates the /run link from
+   it at boot (UTC on a new card). */
+#define PORT_LOCAL_TIME CONF_CONFIG_PATH "localtime"
+#define PORT_RUN_TIME "/run/muos/localtime"
 #include <common/ui/orientation.h>
 #include "ui/ui_muxrtc.h"
 
@@ -93,7 +101,7 @@
     static char zone[MAX_BUFFER_SIZE];
 
     char target[MAX_BUFFER_SIZE];
-    const ssize_t len = readlink(LOCAL_TIME, target, sizeof(target) - 1);
+    const ssize_t len = readlink(PORT_RUN_TIME, target, sizeof(target) - 1);
 
     if (len <= 0) return lang.generic.unknown;
     target[len] = '\0';
