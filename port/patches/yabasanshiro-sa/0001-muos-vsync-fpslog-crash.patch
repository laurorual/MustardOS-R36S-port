+// muOS (M8d T3): a SIGSEGV/SIGBUS/SIGABRT handler that prints the stack
+// (raw addresses and the load base, for addr2line on the unstripped build)
+#include <execinfo.h>
+#include <signal.h>
+static void muos_crash(int sig){
+  void *pc[48];
+  char line[256];
+  int n = backtrace(pc, 48);
+  int l = snprintf(line, sizeof line, "muos-yabasanshiro: signal %d, stack:\n", sig);
+  write(2, line, l);
+  backtrace_symbols_fd(pc, n, 2);
+  FILE *m = fopen("/proc/self/maps", "r");
+  if (m) { while (fgets(line, sizeof line, m)) if (strstr(line, "yabasanshiro")) { write(2, line, strlen(line)); break; } fclose(m); }
+  signal(sig, SIG_DFL);
+  raise(sig);
+}
+
 int main(int argc, char** argv)
 {
+  signal(SIGSEGV, muos_crash); signal(SIGBUS, muos_crash); signal(SIGABRT, muos_crash);
