config BR2_PACKAGE_MUOS_MUXRETRO_PROVIDER
	bool "muOS muxretro (frontend provider, manual caller only)"
	depends on BR2_aarch64
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_USE_WCHAR
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_TOOLCHAIN_HAS_SYNC_4
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_4_9
	depends on !BR2_STATIC_LIBS
	depends on BR2_PACKAGE_HAS_LIBEGL
	depends on BR2_PACKAGE_HAS_LIBGLES
	depends on BR2_PACKAGE_FFMPEG_ARCH_SUPPORTS
	depends on !BR2_PACKAGE_MUOS_MUXRETRO
	default n
	select BR2_PACKAGE_MUOS_FRONTEND_LIBS
	help
	  Build the pinned native host with matching frontend headers and
	  rcheevos, linking the muos-frontend-libs staging installation.
	  Include the MUOS_R35S_FRONTEND external tree as well.
	  No private prebuilt frontend SDK, core, ROM, save or service is
	  installed. Mutually exclusive with the historical SDK host.
