#!/bin/sh
# SPDX-License-Identifier: MIT
# Minimal diagnostic PID 1. No product services, modules, networking or reboot.
export PATH=/bin
[ "$$" = 1 ] || { echo 'This init requires PID 1' >&2; exit 64; }
trap '' HUP INT TERM
park() { while :; do sleep 3600; done; }
screen() {
    printf '\033[0m\033[37;40m\033[2J\033[H%s\n' "$1" > /dev/tty0
}
fail() {
    screen "muOS Linux diagnostic: STOPPED
$1
No frontend or network started.
Record this message before powering off."
    park
}
mount -t proc proc /proc || park
mount -t sysfs sysfs /sys || park
mount -t devtmpfs devtmpfs /dev || park
mkdir -p /run /boot
printf '3 4 1 7\n' > /proc/sys/kernel/printk
screen 'muOS - R35S / Panel 0
Linux diagnostic: INIT REACHED
Collecting logs; do not remove the card.'
[ "$(uname -r)" = 4.4.189-muos-r35s-p4 ] || fail 'Unexpected kernel'
[ "$(uname -m)" = aarch64 ] || fail 'Unexpected architecture'
[ "$(tr -d '\000' < /sys/firmware/devicetree/base/model)" = 'R36S-V12 2023-08-18 Panel 0' ] || fail 'Unexpected model'
. /card-guard.sh
diag_part=
diag_wait=0
while [ "$diag_wait" -lt 20 ]; do
    diag_part=$(diag_card /sys) && [ -b "$diag_part" ] && break
    diag_part=
    sleep 1
    diag_wait=$((diag_wait + 1))
done
[ -n "$diag_part" ] || fail 'Test card missing or protected card present'
mount -t vfat -o ro,nosuid,nodev,noexec "$diag_part" /boot || fail 'Test FAT mount failed'
[ "$(cat /boot/DIAG.ID 2>/dev/null)" = MUOS-R35S-LINUX-P4-A01 ] || {
    umount /boot
    fail 'Test FAT marker mismatch'
}
# Let built-in drivers finish probing. No modules or firmware are loaded here.
sleep 10
{
    echo 'MUOS-R35S-LINUX-P4-A01'
    uname -a
    echo 'MODEL'; tr '\000' '\n' < /sys/firmware/devicetree/base/model
    echo 'CMDLINE'; cat /proc/cmdline
    echo 'TAINT'; cat /proc/sys/kernel/tainted
    echo 'UPTIME'; cat /proc/uptime
    echo 'MEMORY'; cat /proc/meminfo
    echo 'MOUNTS'; cat /proc/mounts
    echo 'INPUT'; cat /proc/bus/input/devices
    echo 'FRAMEBUFFER'; cat /proc/fb
    echo 'IOMEM'; cat /proc/iomem
    echo 'MODULES'; cat /proc/modules
    echo 'LOG_DEVICE'; echo "$diag_part"
} > /run/report.txt
dmesg > /run/dmesg.txt
mount -o remount,rw,nosuid,nodev,noexec /boot || fail 'Cannot enable test-log writes'
mkdir -p /boot/DIAG01 || fail 'Cannot create log directory'
cp /run/report.txt /boot/DIAG01/REPORT.TXT || fail 'Cannot save report'
cp /run/dmesg.txt /boot/DIAG01/DMESG.TXT || fail 'Cannot save kernel log'
printf '%s\n' 'INIT_REACHED_AND_LOGS_SAVED' > /boot/DIAG01/RESULT.TXT || fail 'Cannot save result'
sync
umount /boot || fail 'Test FAT unmount failed; do not remove card'
screen 'muOS - R35S / Panel 0
Linux diagnostic: INIT REACHED
Logs saved: DIAG01 (FAT unmounted)
No frontend or network started.
Hold Power to turn off before changing cards.'
park
