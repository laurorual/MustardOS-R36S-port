# Only for a host-built SD monitor probe, not a finished firmware config.
CONFIG_LOCALVERSION="-muos-r35s-p4"
CONFIG_BOOTDELAY=-1
CONFIG_PANIC_HANG=y
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_ENV_IS_IN_MMC is not set
# CONFIG_CMD_SAVEENV is not set
CONFIG_ROCKCHIP_BOOT_MODE_REG=0x0
# CONFIG_ROCKCHIP_VENDOR_PARTITION is not set
# CONFIG_CMD_BOOT_ROCKCHIP is not set
# CONFIG_CMD_RKSFC is not set
# CONFIG_CMD_SF is not set
# CONFIG_CMD_SPI is not set
# CONFIG_SPI_FLASH is not set
# CONFIG_ROCKCHIP_SFC is not set
# CONFIG_RKFLASH is not set
# CONFIG_RKSFC_NOR is not set
# CONFIG_RKSFC_NAND is not set
# CONFIG_CMD_ROCKUSB is not set
# CONFIG_USB_GADGET_DOWNLOAD is not set
# CONFIG_CMD_USB_MASS_STORAGE is not set
# CONFIG_CMD_GPT is not set
# CONFIG_CMD_GO is not set
# CONFIG_TEST_ROCKCHIP is not set
# CONFIG_CMD_EXT4_WRITE is not set
# CONFIG_FAT_WRITE is not set
# CONFIG_DM_CHARGE_DISPLAY is not set
# CONFIG_CMD_CHARGE_DISPLAY is not set
# CONFIG_CMD_ODROID_HWREV is not set
# CONFIG_CMD_ODROID_TEST is not set
# CONFIG_CMD_ODROID_ADC is not set
# CONFIG_CMD_ODROID_BATTERY is not set
# CONFIG_CMD_ODROID_CFGLOAD is not set
# CONFIG_USE_PREBOOT is not set
# CONFIG_OPTEE_CLIENT is not set
# CONFIG_OPTEE_V1 is not set
# CONFIG_OPTEE_V2 is not set
# CONFIG_OPTEE_ALWAYS_USE_SECURITY_PARTITION is not set
