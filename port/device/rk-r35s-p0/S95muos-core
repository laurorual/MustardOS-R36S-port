#!/bin/sh
# SPDX-License-Identifier: MIT
# Limited bootstrap: Buildroot owns udev/DBus. Full muOS sysinit stays absent.
set -eu
audio=1
input=0
audio_quantum=0
[ ! -r /etc/default/muos-core ] || . /etc/default/muos-core
state=/run/muos/core
vars=/opt/muos/frontend/muvarctl
audio_service=/opt/muos/script/init/S80pipewire.sh
audio_ready() {
    "$audio_service" status >/dev/null || return 1
    pidof wireplumber >/dev/null || return 1
    target=$("$vars" get device audio/pf_internal)
    current=$(wpctl inspect @DEFAULT_AUDIO_SINK@ 2>/dev/null |
        sed -n 's/.*node\.name = "\([^"]*\)".*/\1/p' | head -1)
    [ -n "$target" ] && [ "$current" = "$target" ]
}
audio_failure() {
    pw-dump > "$state/pw-dump-failure.json" 2>/dev/null || :
    wpctl status > "$state/wpctl-failure.txt" 2>&1 || :
    "$audio_service" stop || :
}
audio_set_quantum() {
    case "$audio_quantum" in 0) return 0 ;; 1024) ;; *) return 64 ;; esac
    # Set before SDL connects. This is daemon-local metadata, not a saved seed
    # or a rootfs writer; stopping the audio daemon removes the override.
    pw-metadata -n settings 0 clock.force-quantum "$audio_quantum" > "$state/quantum-set.log" || return 1
    pw-metadata -n settings 0 clock.force-quantum > "$state/quantum.txt" || return 1
    grep -Fq "key:'clock.force-quantum' value:'$audio_quantum'" "$state/quantum.txt"
}
audio_prime_pcm() {
    # Panel0/BSP startup workaround: complete one direct zero-only PCM cycle
    # before PipeWire opens the device. The C22 caller bounds the entire start
    # process tree to 45 seconds; aplay itself is limited to 44100 frames.
    [ "$audio_quantum" = 1024 ] || return 0
    [ "$(cat /proc/asound/card0/pcm0p/sub0/status)" = closed ] || return 64
    /usr/bin/aplay -q -D hw:0,0 -M -t raw -f S32_LE -c 2 -r 44100 \
        --period-size=1024 --buffer-size=4096 -d 1 /dev/zero \
        > "$state/pcm-prime.log" 2>&1 || return 1
    [ "$(cat /proc/asound/card0/pcm0p/sub0/status)" = closed ] || return 1
    echo DIRECT_ZERO_PCM_COMPLETED > "$state/pcm-prime.txt"
}
audio_snapshot() {
    # Evidence for the unreproduced "silent until a hard power cut" fault
    # (M2 T3): the RK817 keeps codec state across a warm reboot. Codec
    # registers 0x12-0x4f are uncached and side-effect free to read; the
    # file lands in p3 MUOS/log/system (previous boot kept in system.prev).
    {
        echo "boot $(cat /proc/sys/kernel/random/boot_id) up $(cut -d' ' -f1 /proc/uptime)"
        cat /proc/asound/card0/pcm0p/sub0/status
        for c in 1 3; do amixer -c 0 cget numid=$c 2>&1 | sed -n "s/^ *: values=/numid=$c values=/p"; done
        r=18; while [ "$r" -le 79 ]; do
            printf '%02x=%s ' "$r" "$(i2cget -f -y 0 0x20 "$(printf 0x%02x "$r")" b)"; r=$((r + 1))
        done; echo
    } > /opt/muos/log/audio-codec.txt 2>&1 || :
}
uptime_s() { cut -d. -f1 /proc/uptime; }
# One full attempt: prime, upstream start, then wait for the real target
# node (upstream audio/ready is also set on some failure paths, and
# WirePlumber creates the sink asynchronously after S80 start returns).
audio_start() {
    audio_prime_pcm || return 1
    "$audio_service" start || return 1
    ready_wait=0
    while ! audio_ready && [ "$ready_wait" -lt 80 ]; do sleep 0.1; ready_wait=$((ready_wait + 1)); done
    audio_ready && audio_set_quantum
}
check_model() {
    model=$(tr '\000' '\n' < /sys/firmware/devicetree/base/model)
    [ "$model" = 'R36S-V12 2023-08-18 Panel 0' ] || {
        echo 'muOS core: unexpected hardware model' >&2; return 1;
    }
}
case "${1:-}" in
    start)
        case "$audio_quantum" in 0|1024) ;; *) exit 64 ;; esac
        check_model
        [ ! -e "$state/ready" ] || exit 0
        mkdir -p "$state" /run/muos/storage /opt/muos/log
        "$vars" build
        # Audio failure degrades to a silent UI: input (muinput) must still
        # start, or the autostarted menu would have no controls at all.
        audio_rc=0
        if [ "$audio" = 1 ]; then
            export MUOS_AUDIO_LOG_DIR="$state"
            if [ ! -S /run/dbus/system_bus_socket ]; then
                echo 'muOS core: DBus missing' >&2; audio_rc=1
            elif [ -S /run/pipewire-0 ]; then
                # Never start a second audio stack in this runtime.
                echo 'muOS core: foreign audio stack' >&2; audio_rc=1
            else
                # A failed start is retried with a fresh daemon pair: on some
                # boots WirePlumber's ALSA device enumerates no profile (empty
                # EnumProfile, no sink) and upstream S80 gives up after its 3 s
                # node budget, which left the whole boot silent (M2 T3). The
                # deadline keeps input startup well inside S95's 45 s bound.
                attempt=1 deadline=$(( $(uptime_s) + 25 ))
                until audio_start; do
                    audio_failure
                    for f in pw-dump-failure.json wpctl-failure.txt; do
                        [ ! -e "$state/$f" ] || mv "$state/$f" "$state/attempt$attempt-$f"
                    done
                    if [ "$attempt" -ge 3 ] || [ "$(uptime_s)" -ge "$deadline" ]; then
                        audio_rc=1; break
                    fi
                    echo "muOS core: audio attempt $attempt failed, retrying" >&2
                    attempt=$((attempt + 1)); sleep 1
                done
                if [ "$audio_rc" = 0 ]; then touch "$state/audio"; fi
                echo "$attempt" > "$state/audio-attempts"
                audio_snapshot
            fi
            [ "$audio_rc" = 0 ] || echo 'muOS core: audio unavailable, continuing silent' >&2
        fi
        if [ "$input" = 1 ]; then
            start-stop-daemon -S -b -m -p "$state/input.pid" \
                -x /opt/muos/frontend/muinput -- --device rk-r35s-p0 --foreground --rumble-strength 0
        fi
        touch "$state/ready"
        exit "$audio_rc"
        ;;
    stop)
        if [ -r "$state/input.pid" ]; then
            start-stop-daemon -K -p "$state/input.pid" -x /opt/muos/frontend/muinput || :
            rm -f "$state/input.pid"
        fi
        if [ -e "$state/audio" ]; then
            "$audio_service" stop
            rm -f "$state/audio"
        fi
        rm -f "$state/ready"
        ;;
    status)
        [ -e "$state/ready" ] || exit 3
        [ ! -e "$state/audio" ] || audio_ready
        ;;
    *) echo 'Usage: S95muos-core start|stop|status' >&2; exit 2 ;;
esac
