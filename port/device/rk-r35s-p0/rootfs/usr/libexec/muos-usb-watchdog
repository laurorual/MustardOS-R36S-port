#!/bin/sh
# SPDX-License-Identifier: MIT
# M4f: the dwc2 driver (USB port of the Wi-Fi dongle, ff300000.usb) misses
# port events now and then: an unplug (M4e T3) and a plug (M4e.1 T3, 1 in 4)
# left no kernel event although the port register HPRT0 (0xff300440, bit 0 =
# a device is connected) had changed; Wi-Fi then stayed down until another
# replug. Every 2 s this compares HPRT0 bit 0 with the kernel's device on
# the port (usb 1-1); 3 disagreeing reads in a row (~6 s; an enumeration or
# the dongle's CD-ROM switch takes < 1 s) rebind the dwc2 driver, which
# re-detects the port: the hotplug rule then restarts the network as for a
# real replug (Wi-Fi back ~17 s after the rebind, M4f T2). 30 s pause after
# a rebind. Idle during sleep/resume (suspend.lock). HPRT0 is read only
# while dwc2 is bound (an unclocked controller must not be touched). A stop
# (TERM) during a rebind still binds first, and dwc2 found unbound for 10 s
# is bound again (M4f T2: a test killed between unbind and bind left the
# port dead until a reboot), except while muos-suspend defers Wi-Fi until
# the game ends (network/deferred, M8).
# M7: Wi-Fi liveness. The 8821cu firmware can fall into a C2H/H2C error
# loop while connected: the address stays, nothing gets through (M5
# incident). Every 60 s while the network is "ready": C2H errors logged
# since the radio came up, or two checks in a row without a received
# packet and without an ARP answer from the gateway, rebind dwc2 like a
# missed replug (the dongle is reset and re-enumerated; the hotplug rule
# brings Wi-Fi back). At most one such rebind per 10 min.
#   muos-usb-watchdog            run (S97)
#   MUOS_USB_WATCH_DEV=PATH      test hook: the kernel device path to check
#                                (a missing path simulates a missed plug)
#   MUOS_USB_WATCH_ONCE=1        test hook: exit after the first rebind
#   MUOS_WIFI_LIVE_PERIOD=N      test hook: liveness check every N loops (30)
#   MUOS_WIFI_LIVE_RX=FILE MUOS_WIFI_LIVE_GW=IP   test hooks: the received
#                                packet counter and the gateway to ask
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
dwc=ff300000.usb
drv=/sys/bus/platform/drivers/dwc2
dev=${MUOS_USB_WATCH_DEV:-/sys/bus/usb/devices/1-1}
lock=/run/muos/suspend.lock
say() { echo "$(cut -d' ' -f1 /proc/uptime) usb-watchdog: $*"; }
busy() { [ -e "$lock" ] && ! flock -n "$lock" true; }
bind() { [ -e "$drv/$dwc" ] || echo "$dwc" > "$drv/bind" 2>/dev/null || say 'bind failed'; }
net=/run/muos/network
period=${MUOS_WIFI_LIVE_PERIOD:-30}
tick=0 rx_last='' quiet=0 live_next=0
# Exit 0 with the reason in $why when Wi-Fi is dead, 1 while it looks
# alive (runs in this shell: it keeps quiet/rx_last between checks).
wifi_dead() {
    if [ ! -e "$net/ready" ] || [ ! -s "$net/address" ]; then quiet=0 rx_last=''; return 1; fi
    ifc=$(cat "$net/interface" 2>/dev/null || echo wlan0)
    if dmesg | awk '/muos-network: radio up/ { f = 0 } /c2h_handler_rtl8821c: \[ERROR\]/ { f = 1 } END { exit !f }'; then
        why='driver firmware errors (C2H) while connected'; return 0
    fi
    rxf=${MUOS_WIFI_LIVE_RX:-/sys/class/net/$ifc/statistics/rx_packets}
    rx=$(cat "$rxf" 2>/dev/null) || return 1
    if [ "$rx" != "$rx_last" ]; then rx_last=$rx quiet=0; return 1; fi
    gw=${MUOS_WIFI_LIVE_GW:-$(route -n | awk -v i="$ifc" '$1 == "0.0.0.0" && $NF == i { print $2; exit }')}
    [ -n "$gw" ] || return 1
    if arping -f -q -c 3 -w 4 -I "$ifc" "$gw" > /dev/null 2>&1; then quiet=0; return 1; fi
    rx_last=$(cat "$rxf" 2>/dev/null)
    quiet=$((quiet + 1))
    [ "$quiet" -ge 2 ] || return 1
    why="nothing received for $((quiet * period * 2)) s, gateway $gw silent"; return 0
}
rebind() {
    rebinding=1
    echo "$dwc" > "$drv/unbind" 2>/dev/null || say 'unbind failed'
    sleep 2
    bind; rebinding=0
}
rebinding=0
trap '[ "$rebinding" = 0 ] || bind; exit 0' TERM INT HUP
bad=0 gone=0
say "started (device $dev)"
while sleep 2; do
    # muos-suspend unbinds dwc2 itself around "mem" (net_down/net_up) and,
    # woken in a game, leaves it unbound until the game ends (M8).
    if busy || [ -e "$net/deferred" ]; then bad=0 gone=0; continue; fi
    if [ ! -e "$drv/$dwc" ]; then
        gone=$((gone + 1)); bad=0
        [ "$gone" -ge 5 ] || continue
        say 'dwc2 unbound for 10 s: bind'; bind; gone=0; continue
    fi
    gone=0
    tick=$((tick + 1))
    if [ "$tick" -ge "$period" ]; then
        tick=0
        now=$(cut -d. -f1 /proc/uptime)
        if [ "$now" -ge "$live_next" ] && wifi_dead; then
            say "Wi-Fi dead: $why: rebind dwc2"
            rebind; quiet=0 rx_last='' live_next=$((now + 600))
            [ -z "${MUOS_USB_WATCH_ONCE:-}" ] || { say 'once: done'; exit 0; }
            sleep 30; continue
        fi
    fi
    h=$(devmem 0xff300440 32 2>/dev/null) || continue
    case "$h" in 0x*) ;; *) continue ;; esac
    conn=$(( h & 1 ))
    if [ -e "$dev" ]; then kern=1; else kern=0; fi
    if [ "$conn" = "$kern" ]; then bad=0; continue; fi
    bad=$((bad + 1))
    [ "$bad" -ge 3 ] || continue
    if [ "$conn" = 1 ]; then what='plug'; else what='unplug'; fi
    say "missed $what (HPRT0 $h, usb 1-1 $( [ "$kern" = 1 ] && echo present || echo absent )): rebind dwc2"
    rebind
    bad=0
    [ -z "${MUOS_USB_WATCH_ONCE:-}" ] || { say 'once: done'; exit 0; }
    sleep 30
done
