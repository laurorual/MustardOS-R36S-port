#!/bin/sh
# SPDX-License-Identifier: MIT
# M13 (decision 50): the "Install" step of MustardOS's first boot on the
# port's card, which keeps everything on one partition (p3) as upstream's
# SD1. muxinstall asks how it is formatted (device storage/rom/type: exfat,
# vfat or ext4).
#   request FS   the progress screen (muos-install-task.sh): note FS in p3
#                MUOS/port/install-storage; the device then restarts
#   apply        S89, the next start, p3 mounted and nothing else using it:
#                keep the first boot's state (MUOS/port: settings, time
#                zone, ...; MUOS/log) in RAM, unmount p3, grow it to the end
#                of the card (MBR end, type 83/07/0c; the start never moves,
#                nothing before it is written), format it (ext4 that is
#                already ext4 is only grown, online), put the state back
#                with boot/factory_reset 0. S89 then mounts it by type, and
#                the start seeds it (ROMS folders, themes, names).
# Safety: it only formats a card without games, BIOS or saves (a fresh
# one). A failed format becomes ext4 again with the kept state and
# factory_reset 1: the first boot comes back. A power cut while p3 is
# unmounted (seconds) leaves a fresh or empty p3: the next start seeds it
# from the image and the first boot starts over.
# Log: p3 MUOS/log/install-storage.log (and /run/muos-install-storage.log).
# T1 (MUOS_INSTALL_TEST=DIR, port/scripts/t1-install-storage.sh): DISK is an
# image file, p3's files are DIR/data, the new filesystem goes to DIR/p3.img
# and the restored state to DIR/restored; the kernel, mount and resize steps
# are skipped.
#   muos-install-storage request exfat|vfat|ext4 | apply [DISK]
set -u
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
test=${MUOS_INSTALL_TEST:-}
data=${test:+$test/data}; data=${data:-/userdata}
req=$data/MUOS/port/install-storage
rlog=${test:-/run}/muos-install-storage.log
say() { echo "$(date '+%F %T') $*" >> "$rlog"; }
die() { say "FAIL $*"; echo "$*" >&2; keep_log; exit 1; }
keep_log() { [ -d "$data/MUOS" ] && mkdir -p "$data/MUOS/log" && cat "$rlog" >> "$data/MUOS/log/install-storage.log" 2>/dev/null && : > "$rlog"; }
case "${1:-}" in
request)
    case "${2:-}" in exfat|vfat|ext4) ;; *) echo 'Usage: muos-install-storage request exfat|vfat|ext4' >&2; exit 2 ;; esac
    mkdir -p "${req%/*}" && printf '%s\n' "$2" > "$req.tmp" && mv -f "$req.tmp" "$req" && sync || exit 1
    say "requested $2"; keep_log; exit 0 ;;
apply) ;;
*) echo 'Usage: muos-install-storage request exfat|vfat|ext4 | apply [DISK]' >&2; exit 2 ;;
esac
fs=$(head -n 1 "$req" 2>/dev/null)
case "$fs" in exfat|vfat|ext4) ;; *) rm -f "$req"; die "bad request '$fs'" ;; esac
disk=${2:-$(/usr/libexec/muos-boot-disk)}
name=${disk##*/}
case "$name" in *[0-9]) p=${name}p ;; *) p=$name ;; esac
dev=/dev/${p}3
say "apply $fs on $disk"
# ---- the table (sectors) --------------------------------------------------
dump=$(sfdisk -d "$disk" 2>/dev/null) || die "cannot read the partition table of $disk"
printf '%s\n' "$dump" | grep -qx 'label: dos' || die 'not an MBR card'
printf '%s\n' "$dump" | grep -qx 'label-id: 0x4d554432' || die 'not the port card (disk id)'
nparts=$(printf '%s\n' "$dump" | grep -c '^/dev\|^[^ :]*[0-9] :')
[ "$nparts" = 3 ] || die "unexpected layout ($nparts partitions)"
s3=$(printf '%s\n' "$dump" | sed -n 's|^[^ ]*[^0-9]3 :.* start= *\([0-9]*\),.*|\1|p')
[ -n "$s3" ] || die 'no p3'
if [ -n "$test" ]; then cur=$(cat "$test/p3.type" 2>/dev/null || echo ext4)
else cur=$(blkid -o value -s TYPE "$dev" 2>/dev/null); fi
grow_table() { # p3 to the end of the card, MBR type $1
    echo ', +' | sfdisk -q --no-reread --no-tell-kernel -N 3 "$disk" >> "$rlog" 2>&1 || return 1
    sfdisk -q --no-reread --no-tell-kernel --part-type "$disk" 3 "$1" >> "$rlog" 2>&1 || return 1
    new=$(sfdisk -d "$disk" 2>/dev/null | sed -n 's|^[^ ]*[^0-9]3 :.* size= *\([0-9]*\),.*|\1|p')
    say "p3 now $new sectors, type $1"
    [ -n "$test" ] && return 0
    resizepart "$disk" 3 "$new" >> "$rlog" 2>&1 || return 1
    udevadm settle -t 10 >> "$rlog" 2>&1 || :
    n=0; while [ ! -b "$dev" ] && [ "$n" -lt 50 ]; do sleep 0.1; n=$((n + 1)); done
}
set_factory0() { mkdir -p "$1/MUOS/port/config/boot" && printf '0\n' > "$1/MUOS/port/config/boot/factory_reset"; }
# ---- ext4 that is ext4: grow only, nothing is formatted -------------------
if [ "$fs" = ext4 ] && [ "$cur" = ext4 ]; then
    grow_table 83 || die 'growing p3 failed'
    [ -n "$test" ] || resize2fs "$dev" >> "$rlog" 2>&1 || die 'resize2fs failed'
    set_factory0 "$data" || die 'cannot clear boot/factory_reset'
    rm -f "$req"; sync; say "done: ext4 grown"; keep_log; exit 0
fi
# ---- a new filesystem: only on a fresh card -------------------------------
# (MUOS/pickles is not a sign of use: S91's one-shot migrations seed the
# Flycast options there on the first start; it is kept below instead, as
# .migrations in MUOS/port says they already ran.)
for d in ROMS MUOS/bios MUOS/save MUOS/screenshot MUOS/PortMaster MUOS/application; do
    [ -z "$(find "$data/$d" -type f 2>/dev/null | head -n 1)" ] ||
        { rm -f "$req"; die "the card already has files in $d: not formatted (choose EXT4, or flash it again)"; }
done
keep=${test:-/run}/muos-install-keep
rm -rf "$keep"; mkdir -p "$keep/MUOS"
for d in MUOS/port MUOS/pickles MUOS/log MUOS/preferences; do
    [ -d "$data/$d" ] && { cp -R "$data/$d" "$keep/$d" || die "cannot keep $d"; }
done
[ ! -f "$data/.muos-r35s-data-v1" ] || cp "$data/.muos-r35s-data-v1" "$keep/"
rm -rf "$keep/MUOS/port/seeded-theme" "$keep/MUOS/port/install-storage"
kb=$(du -sk "$keep" | cut -f1)
[ "$kb" -le $((128 * 1024)) ] || die "the first boot's state is ${kb} KiB: not formatted"
set_factory0 "$keep" || die 'cannot clear boot/factory_reset'
cat "$rlog" >> "$keep/MUOS/log/install-storage.log" 2>/dev/null; : > "$rlog"
say "kept ${kb} KiB of state; formatting p3 as $fs"
sync
if [ -z "$test" ]; then
    umount "$data" || die 'p3 is busy: not formatted'
fi
# from here p3 is unmounted: every way out puts a filesystem with the state back
case $fs in exfat) type=7 ;; vfat) type=c ;; ext4) type=83 ;; esac
target=$dev; [ -z "$test" ] || target=$test/p3.img
mkfs_as() { # FS
    if [ -n "$test" ]; then
        [ "${MUOS_INSTALL_FAIL:-}" != "$1" ] || return 1 # T1: a failing format
        size=$(sfdisk -d "$disk" | sed -n 's|^[^ ]*[^0-9]3 :.* size= *\([0-9]*\),.*|\1|p')
        rm -f "$target"; truncate -s $((size * 512)) "$target"; printf '%s\n' "$1" > "$test/p3.type"
    fi
    case $1 in
        exfat) mkfs.exfat -n MustardOS "$target" ;;
        vfat) mkfs.vfat -F 32 -n MUSTARDOS "$target" ;;
        ext4) mke2fs -q -F -t ext4 -L MUOSDATA "$target" ;;
    esac >> "$rlog" 2>&1
}
restore() { # put the state back on the new filesystem (mounted plainly)
    if [ -n "$test" ]; then mkdir -p "$test/restored" && cp -R "$keep/." "$test/restored/"; return; fi
    [ "$1" != exfat ] || modprobe -q exfat || :
    mount -t "$1" -o rw,noatime "$target" "$data" || return 1
    cp -R "$keep/." "$data/" 2>> "$rlog" || say 'some state was not copied back (links on exFAT/FAT32)'
    [ -f "$data/MUOS/port/config/boot/factory_reset" ]; rc=$?
    sync; umount "$data" || :
    return "$rc"
}
ok=0
if grow_table "$type" && mkfs_as "$fs"; then
    say "p3 formatted $fs"
    restore "$fs" && ok=1
fi
if [ "$ok" = 0 ]; then
    say "FAIL formatting p3 as $fs: back to ext4 with the first boot's state (the first boot comes back)"
    printf '1\n' > "$keep/MUOS/port/config/boot/factory_reset"
    sfdisk -q --no-reread --no-tell-kernel --part-type "$disk" 3 83 >> "$rlog" 2>&1 || :
    mkfs_as ext4 && restore ext4 || say 'FAIL the ext4 fallback too: flash the card again'
    cat "$rlog" >> "$keep/MUOS/log/install-storage.log" 2>/dev/null
    echo "formatting p3 as $fs failed" >&2
    exit 1
fi
say "done: $fs"
[ -n "$test" ] || rm -rf "$keep"
exit 0
