#!/bin/sh
# SPDX-License-Identifier: MIT
# muos-flycast ROM: standalone Flycast v2.7 (DC; M8 thermal block T9,
# heavy systems = performance first), as dArkOSen runs it since 2026-11
# (dreamcast.sh standalone-Flycast, /opt/flycastsa): built by
# build-flycast-sa.sh, run by muos-frontend for the DC "ext-flycast"
# assignment. Settings: dArkOSen's emu.cfg (640x480, threaded rendering,
# auto frame skip 2, per-strip sorting, DSP off) plus auto save state on
# exit and auto load on start (Fn+Start = SIGTERM = a normal quit).
# Data p3 MUOS/port/flycast: XDG config (emu.cfg, mappings) and data
# (the BIOS from MUOS/bios/dc, VMU and save states).
# Sleep: muos-suspend stops and continues the process.
set -u
emu=/opt/muos/share/emulator/flycast
w=/userdata/MUOS/port/flycast
rom=${1:?rom}
say() { echo "muos-flycast: $*"; }
mkdir -p "$w/config/flycast" "$w/data/flycast" || exit 1
[ -s "$w/config/flycast/emu.cfg" ] || cp /usr/share/muos-r35s/flycast/emu.cfg "$w/config/flycast/emu.cfg"
for b in dc_boot.bin dc_flash.bin; do
    [ -e "$w/data/flycast/$b" ] || [ ! -f "/userdata/MUOS/bios/dc/$b" ] || cp "/userdata/MUOS/bios/dc/$b" "$w/data/flycast/"
done
map=/userdata/MUOS/port/gamecontrollerdb/retro.txt
[ -s "$map" ] || map=/opt/muos/share/info/gamecontrollerdb/retro.txt
. /usr/share/muos-r35s/sdl-env.sh
SDL_GAMECONTROLLERCONFIG=$(sdl_map_line "$map")
export SDL_GAMECONTROLLERCONFIG
pre=
# T2 hook (t2-swapstat.sh): frame timing, only with a test-pushed /run file
[ -e /run/muos/perf-capture ] && [ -f /run/muos/swapstat.so ] && pre=/run/muos/swapstat.so
say "start rom=$rom"
cd "$w" || exit 1
HOME=$w XDG_CONFIG_HOME=$w/config XDG_DATA_HOME=$w/data LD_PRELOAD=$pre exec "$emu/flycast" "$rom"
