#!/bin/sh
# SPDX-License-Identifier: MIT
# M8: Fn+Start (hotkey QUIT_STANDALONE, opt/muos/share/hotkey/standalone.json)
# quits a standalone emulator that has no such combo of its own, as
# dArkOSen's killer_daemon (pkill, then kill -9 if still there): SIGTERM,
# which SDL turns into a normal quit (PPSSPP saves its settings;
# YabaSanshiro, M8 item 17: SIGKILL after 3 s if it is still there).
# Emulators that quit on Fn+Start themselves are only waited for:
# Mupen64Plus (its own combo, autosave) and DraStic with the advanced hook
# (its HOT_QUIT = Fn+Start writes the auto save state and quits; M8c T3 5:
# a SIGTERM during that save deadlocked the hook, "busy saving old one",
# and the SIGKILL 5 s later left an empty temp state, so the next start
# loaded an old one). DraStic gets SIGTERM only if it is still there after
# 8 s, SIGKILL 5 s after that.
# M8c T3 5: the screen darkens while the emulator saves and quits (the
# picture freezes meanwhile). M8d T3: a fade instead of a jump: the
# backlight eases to black in ~0.4 s, stays dark until the emulator is gone
# and the menu has had a moment to draw, then eases back in ~0.3 s.
bl=/sys/class/backlight/backlight/brightness
say() { echo "muos-standalone-quit: $*"; }
gone() { ! kill -0 "$1" 2>/dev/null; }
wait_gone() { # PID TENTHS
    n=0; while [ "$n" -lt "$2" ] && ! gone "$1"; do sleep 0.1; n=$((n+1)); done
    gone "$1"
}
level=$(cat "$bl" 2>/dev/null) || level=0
faded=0
# fade FROM TO: 10 steps of ~35 ms, eased (quadratic towards the dark end)
fade() {
    i=1
    while [ "$i" -le 10 ]; do
        if [ "$2" -lt "$1" ]; then r=$(( (10 - i) * (10 - i) )); else r=$(( i * i )); fi
        hi=$1; [ "$2" -gt "$1" ] && hi=$2
        echo $(( hi * r / 100 )) > "$bl" 2>/dev/null
        sleep 0.035; i=$((i+1))
    done
}
dim() { [ "$faded" = 0 ] && [ "$level" -gt 0 ] 2>/dev/null && { fade "$level" 0; faded=1; }; }
restore() {
    [ "$level" -gt 0 ] 2>/dev/null || return 0
    if [ "$faded" = 1 ]; then sleep 0.4; fade 0 "$level"; faded=0; fi
    echo "$level" > "$bl" 2>/dev/null
}
trap 'restore; exit 0' INT TERM HUP
# M11: a port or application session (muos-session): SIGTERM to its whole
# process group (the port, gptokeyb, its runtime), SIGKILL to what is left
# after 3 s. The group, not its leader: the port's bash script dies at once
# while a game can ignore SIGTERM (SDL Sopwith, M11 T2).
s=$(cat /run/muos/session 2>/dev/null || :)
if [ -n "$s" ] && kill -0 -"$s" 2>/dev/null; then
    t0=$(cut -d' ' -f1 /proc/uptime)
    dim
    kill -TERM -"$s" 2>/dev/null
    wait_gone -"$s" 30 || { say "session $s still running, SIGKILL"; kill -KILL -"$s" 2>/dev/null; wait_gone -"$s" 10; }
    say "session $s quit $t0 -> $(cut -d' ' -f1 /proc/uptime)"
    restore
    exit 0
fi
for e in PPSSPPSDL drastic mupen64plus yabasanshiro scummvm flycast; do
    pid=$(pidof "$e") || continue
    t0=$(cut -d' ' -f1 /proc/uptime)
    # the fade over the game picture first (PPSSPP and YabaSanshiro clear
    # the screen as soon as they get the signal), then the signal
    dim
    case $e in PPSSPPSDL|yabasanshiro|scummvm|flycast) kill -TERM "$pid" ;; esac
    case $e in
        PPSSPPSDL) wait_gone "$pid" 50 ;;
        yabasanshiro|scummvm|flycast) wait_gone "$pid" 30 || { say "$e still running, SIGKILL"; kill -KILL "$pid"; } ;;
        drastic)
            wait_gone "$pid" 76 || { say "drastic still running, SIGTERM"; kill -TERM "$pid"; wait_gone "$pid" 50 || {
                say "drastic still running, SIGKILL"; kill -KILL "$pid"; }; } ;;
        mupen64plus) wait_gone "$pid" 100 ;;
    esac
    say "$e $pid quit $t0 -> $(cut -d' ' -f1 /proc/uptime)"
done
restore
exit 0
