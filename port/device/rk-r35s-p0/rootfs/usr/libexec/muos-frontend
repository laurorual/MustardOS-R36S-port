#!/bin/sh
# SPDX-License-Identifier: MIT
# Port frontend loop, after MustardOS internal/script/mux/frontend.sh:
#   muxfrontend reads its module from /run/muos/action and exits to request
#   content (/run/muos/content, 9-line ROM_GO record), reboot or shutdown.
#   Content runs in muxretro (libretro cores in /opt/muos/share/core), or
#   (M7) N64's ext-mupen64plus-* assignments in muos-mupen64plus.
# muxfrontend SIGTERMs itself when its parent is PID 1, hence this owner.
# Usage (from S99muos-ui): muos-frontend HOTKEYS(0|1) AUDIO(pipewire|dummy)
export HOME=/root XDG_RUNTIME_DIR=/run PIPEWIRE_RUNTIME_DIR=/run LC_ALL=C.UTF-8
export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket
export PATH=/opt/muos/frontend:/opt/muos/bin:/usr/sbin:/usr/bin:/sbin:/bin
export SDL_JOYSTICK_HIDAPI=0 SDL_VIDEODRIVER=KMSDRM SDL_AUDIODRIVER="${2:-dummy}"
export SDL_VIDEO_EGL_DRIVER=libEGL.so SDL_VIDEO_GL_DRIVER=libGLESv2.so
export LD_BIND_NOW=1 LD_LIBRARY_PATH=/opt/muos/frontend/lib
run=/run/muos
act=$run/action
rom=$run/content
exec >> /opt/muos/log/frontend-loop.log 2>&1
say() { printf '%s %s\n' "$(cut -d' ' -f1 /proc/uptime)" "$*"; }
child='' hotkey=''
quit() {
    say "stop requested"
    [ -z "$child" ] || kill -TERM "$child" 2>/dev/null
    [ -z "$hotkey" ] || kill -TERM "$hotkey" 2>/dev/null
    wait
    exit 0
}
trap quit TERM INT HUP
run_child() { "$@" & child=$!; wait "$child"; rc=$?; child=; return "$rc"; }
foreground() { muvarctl set system foreground_process "$1" >/dev/null 2>&1 || :; }
# CPU governor, as upstream launch.sh / SET_DEFAULT_GOVERNOR: the content's
# request (/run/muos/governor, from muOS core.gov) while it runs, the device
# default (device/config/cpu/default) in the frontend. muos-governor also
# moves the GPU floor, deep CPU idle and DDR with it (upstream SYNC_*).
set_governor() {
    if /usr/libexec/muos-governor "$1"; then
        say "governor $1 (dmc $(cat /sys/class/devfreq/dmc/governor 2>/dev/null))"
    else
        say "governor $1 refused"
    fi
}
default_governor() { set_governor "$(cat /opt/muos/device/config/cpu/default 2>/dev/null || echo schedutil)"; }

# Per-launch request files the frontend writes for launch.sh (governor,
# controller, filter, ...). Upstream consumes them; left behind, the next
# muxfrontend start treats them as an "option" request.
clear_requests() {
    for f in governor controller filter retroarch shader overlay_options auto_core \
             auto_governor auto_retroarch overlay overlay.filter overlay.shader overlay.options; do
        rm -f "$run/$f"
    done
    rm -f /tmp/ra_no_load /tmp/ra_autoload_once.cfg
}

# M7: now and then (1 in ~50 menu restarts in T2, after a sweep of all
# screens) PipeWire's ALSA sink stops writing: the PCM runs (hw_ptr moves)
# but appl_ptr is frozen, every client starves (muxretro discards its
# audio, the standalone N64 blocks in audio-sdl's sync) until PipeWire
# restarts. Checked before each game (0.1 s = 4 periods); restarted only
# when stuck: RUNNING with appl_ptr frozen while hw_ptr moves, or XRUN at
# both reads (PipeWire leaves XRUN at once while it services the PCM; a
# frozen PipeWire shows this). Likely the M3d "no sound" report.
audio_check() {
    [ "$SDL_AUDIODRIVER" = pipewire ] || return 0
    s=/proc/asound/card0/pcm0p/sub0/status
    [ -r "$s" ] || return 0
    pcm() { awk '/^state/ {st=$2} /appl_ptr/ {a=$3} /hw_ptr/ {h=$3} END {print st, a, h}' "$s"; }
    # shellcheck disable=SC2046  # three words
    set -- $(pcm); s1=$1 a1=${2:-} h1=${3:-}
    sleep 0.1
    # shellcheck disable=SC2046
    set -- $(pcm); s2=$1 a2=${2:-} h2=${3:-}
    case "$s1/$s2" in
        RUNNING/RUNNING) [ "$a1" = "$a2" ] && [ "$h1" != "$h2" ] || return 0 ;;
        XRUN/XRUN) ;;
        *) return 0 ;;
    esac
    say "audio: PipeWire sink stuck ($s2, appl_ptr $a1, hw_ptr $h1 -> $h2): restarting PipeWire"
    /opt/muos/script/init/S80pipewire.sh restart >/dev/null 2>&1 || say "audio: PipeWire restart failed"
}

track=/opt/muos/script/mux/track.sh
launch_content() {
    {
        read -r name; read -r core; read -r assign; read -r _; read -r _
        read -r launch; read -r dir1; read -r dir2; read -r file
    } < "$rom"
    rm -f "$rom"
    content="$dir1$dir2/$file"
    say "content name=$name core=$core assign=$assign launch=$launch file=$content"
    [ -f "$content" ] || { say "missing content $content"; return 1; }
    ext=
    case "$core $launch" in
        *ext-mupen64plus*) ext=mupen64plus ;;
        *ext-ppsspp*) ext=ppsspp ;; # M8
        *ext-drastic*) ext=drastic ;; # M8, decision 23
        *ext-yabasanshiro*) ext=yabasanshiro ;; # M8 item 17
        *ext-scummvm*) ext=scummvm ;; # M8 item 5
        *ext-flycast*) ext=flycast ;; # M8 thermal block T9
        *ext-*) say "external launcher $launch not supported yet"; return 1 ;;
    esac
    [ -n "$ext" ] || [ -f "/opt/muos/share/core/$core" ] || { say "missing core $core"; return 1; }
    fresh=; [ ! -e /tmp/ra_no_load ] || fresh=--fresh
    if [ -s "$run/governor" ]; then set_governor "$(head -n1 "$run/governor")"; else default_governor; fi
    clear_requests
    audio_check
    if [ -n "$ext" ]; then
        foreground "$ext"
        TRACK_SYSTEM=$assign "$track" "$name" "$core" "$content" start >> /opt/muos/log/frontend.log 2>&1 || :
        if [ "$ext" = mupen64plus ]; then
            variant=$core; case "$variant" in ext-*) ;; *) variant=$launch ;; esac
            run_child /usr/libexec/muos-mupen64plus "$variant" "$content" "${file%.*}" \
                >> /opt/muos/log/frontend.log 2>&1
        elif [ "$ext" = ppsspp ] && case "$core $launch" in *ext-ppsspp-2021*) true ;; *) false ;; esac; then
            run_child /usr/libexec/muos-ppsspp --2021 "$content" >> /opt/muos/log/frontend.log 2>&1
        else
            run_child "/usr/libexec/muos-$ext" "$content" >> /opt/muos/log/frontend.log 2>&1
        fi
        rc=$?
        say "$ext exit rc=$rc"
        TRACK_EXIT=$rc "$track" "$name" "$core" "$content" stop >> /opt/muos/log/frontend.log 2>&1 || :
        default_governor
        sync
        return 0
    fi
    # M8 item 5: the ScummVM core autodetects the game in the folder of the
    # file it gets. M8f T3 4: a game is NAME/NAME.scummvm (S91 moves the
    # older outer file in): with a game id in it the core launches that id
    # there; empty, it gets the folder's first file and detects the game.
    # Upstream's hidden-folder form (.NAME or _NAME next to NAME.scummvm):
    # a copy goes into that folder (no second explorer entry: the folder is
    # hidden).
    if [ "$core" = scummvm_libretro.so ] && [ "${content##*.}" = scummvm ]; then
        n=${content##*/} g=; n=${n%.*}
        case $content in */"$n/$n.scummvm") g=${content%/*} ;; esac
        if [ -z "$g" ]; then
            for d in "$dir1$dir2/.$n" "$dir1$dir2/_$n" "$dir1$dir2/$n"; do [ -d "$d" ] && { g=$d; break; }; done
        fi
        if [ -n "$g" ] && [ -n "$(tr -d '[:space:]' < "$content")" ]; then
            [ "${content%/*}" = "$g" ] || { cp "$content" "$g/$n.scummvm" && content=$g/$n.scummvm; }
        elif [ -n "$g" ]; then
            f=$(find "$g" -maxdepth 1 -type f ! -name '*.scummvm' | sort | head -n1)
            [ -z "$f" ] || content=$f
        fi
        say "scummvm content $content"
    fi
    foreground muxretro
    # T2 hook: /run/muos/perf-capture arms muxretro's own frame-time capture
    # (writes /run/muos/storage/pickles/performance.csv periodically).
    MUXRETRO_PERF_CAPTURE=0; [ ! -e "$run/perf-capture" ] || MUXRETRO_PERF_CAPTURE=1
    export MUXRETRO_PERF_CAPTURE
    # M8e T2 hook: the core speed meter (t2-coremeter.c), only with a
    # test-pushed /run file
    pre=; [ ! -e "$run/perf-capture" ] || [ ! -f "$run/coremeter.so" ] || pre=$run/coremeter.so
    # M4f: Activity (playtime), as upstream launch.sh (track.sh honours
    # settings/advanced/activity itself; missing = on, the frontend default).
    TRACK_SYSTEM=$assign "$track" "$name" "$core" "$content" start >> /opt/muos/log/frontend.log 2>&1 || :
    # shellcheck disable=SC2086  # $fresh is empty or one flag
    run_child env LD_PRELOAD="$pre" /opt/muos/frontend/muxretro "/opt/muos/share/core/$core" "$content" $fresh \
        >> /opt/muos/log/frontend.log 2>&1
    rc=$?
    say "muxretro exit rc=$rc"
    TRACK_EXIT=$rc "$track" "$name" "$core" "$content" stop >> /opt/muos/log/frontend.log 2>&1 || :
    default_governor
    sync
}

say "loop start hotkeys=${1:-1} audio=$SDL_AUDIODRIVER"
# muos-hotkey owns muhotkey and handles the power/idle hotkeys (sleep).
[ "${1:-1}" != 1 ] || { /usr/libexec/muos-hotkey >> /opt/muos/log/hotkey.log 2>&1 & hotkey=$!; }
[ -s "$act" ] || echo launcher > "$act"
default_governor
fast=0
while :; do
    if [ -s "$rom" ]; then
        launch_content || :
        [ -s "$act" ] || echo explore > "$act"
        continue
    fi
    action=$(head -n1 "$act" 2>/dev/null); [ -n "$action" ] || action=launcher
    case "$action" in
        reboot|shutdown|poweroff)
            say "$action requested"
            [ -z "$hotkey" ] || kill -TERM "$hotkey" 2>/dev/null
            rm -f "$act"; sync
            if [ "$action" = reboot ]; then reboot; else poweroff; fi
            exit 0 ;;
    esac
    rm -f "$run/safe_quit"
    [ "$action" != launcher ] || clear_requests
    t0=$(cut -d. -f1 /proc/uptime)
    foreground muxfrontend
    say "muxfrontend action=$action"
    run_child /opt/muos/frontend/muxfrontend >> /opt/muos/log/frontend.log 2>&1
    rc=$?
    say "muxfrontend exit rc=$rc next=$(head -n1 "$act" 2>/dev/null) content=$([ -s "$rom" ] && echo yes || echo no)"
    sync
    # Crash-loop brake: five quick failures in a row -> back off 30 s.
    if [ "$rc" != 0 ] && [ $(( $(cut -d. -f1 /proc/uptime) - t0 )) -lt 10 ]; then
        fast=$((fast+1))
        [ "$fast" -lt 5 ] || { say "crash loop, backing off"; sleep 30; fast=0; echo launcher > "$act"; }
    else
        fast=0
    fi
done
