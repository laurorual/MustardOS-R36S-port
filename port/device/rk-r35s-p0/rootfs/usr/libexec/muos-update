#!/bin/sh
# SPDX-License-Identifier: MIT
# M9 item 8: firmware updates for v1.x without a reflash (p3 kept). An
# update is NAME.p2.img.gz plus NAME.p2.img.sha256 (the raw p2's sha256)
# in /userdata/MUOS/update/. The Task Toolkit task "Install Firmware
# Update" runs `stage`: unpack into MUOS/trial/rootfs.img, verify, arm the
# trial root, reboot. On that boot muos-frontend runs `resume`: once the
# trial has kept the menu up for 30 s (and the menu is in front again),
# the trial p2 is written to p2 (muos-root-trial write-p2, the old p2 kept
# as MUOS/trial/p2-previous.img). No second reboot: the trial root already
# runs the new firmware, the next start boots it from p2. A trial that
# never reaches the menu falls back to the old p2 by itself (the marker is
# one-shot); `resume` there marks the update failed.
# M9 (v1.0.0): on that trial boot muos-frontend opens the Task Toolkit's
# progress screen at once with `finish` (/usr/libexec/muos-update-finish.sh,
# frontend patch 0013): the frontend drawing it is the proof, the p2 write
# shows its progress, then the device restarts. `resume` writes in the
# background only if that screen never ran. Updates need the charger or
# >= 30 % battery.
# v1.1.1 (T3 request): updates over Wi-Fi are manual. The Task Toolkit
# task "Check for Online Update" runs `check` (the latest GitHub release of
# $repo in /etc/muos-update.conf, offered only when its version is newer
# than this one's) and, when the user accepts, `fetch` (NAME.p2.img.gz +
# .sha256 into MUOS/update, curl with CA-verified TLS, resumable), then
# `stage` as above. Before v1.1.1 an `auto` mode downloaded and staged the
# latest release in the background, older ones too (v1.1.1 to v1.1.0).
# The kernel and DTBs ride in the new p2 (/usr/share/muos-r35s/boot):
# after write-p2, muos-boot-sync arms them as a trial for the next start
# (promoted once it reaches the menu). U-Boot is not updated this way.
#   muos-update stage | finish | resume | status | check | fetch | version NAME
set -eu
upd=/userdata/MUOS/update trial=/userdata/MUOS/trial rt=/usr/libexec/muos-root-trial
repo='' api=https://api.github.com
[ ! -r /etc/muos-update.conf ] || . /etc/muos-update.conf
# T2 (t2-online-update.sh): /run/muos/update-test holds MUOS_UPDATE_API and
# MUOS_UPDATE_RELEASE lines (a local release JSON, a release name to compare
# with); /run is root-only tmpfs, gone at the next start.
# shellcheck disable=SC1091
[ ! -r /run/muos/update-test ] || . /run/muos/update-test
api=${MUOS_UPDATE_API:-$api/repos/$repo/releases/latest}
release=${MUOS_UPDATE_RELEASE:-$(sed -n 's/^release=//p' /etc/muos-port-release 2>/dev/null)}
log() { echo "muos-update: $*"; echo "$(date '+%F %T') $*" >> "$upd/update.log"; }
on_trial() { $rt status 2>/dev/null | grep -q '^trial-root yes'; }
power_ok() { # charger in, or >= 30 % battery
    [ "$(cat /sys/class/power_supply/ac/online 2>/dev/null)" = 1 ] ||
        [ "$(cat /sys/class/power_supply/battery/capacity 2>/dev/null || echo 100)" -ge 30 ]
}
in_menu() { [ "$(cat /opt/muos/config/system/foreground_process 2>/dev/null)" = muxfrontend ]; }
mkdir -p "$upd"
# lock: one update step at a time (a second task, or the old background
# updater of a card being updated, would write the same files)
lock() {
    exec 9> /run/muos/update.lock
    flock -n 9 || { echo 'another update is running: wait for it to end' >&2; exit 1; }
}
# version NAME: a number that orders release names (MustardOS-R36S-port-
# v1.2.3[-rcN]; a release after its candidates); 0 for any other name
# (developer images: every release is newer).
version() {
    echo "$1" | awk '{ if (!match($0, /v[0-9]+\.[0-9]+\.[0-9]+(-rc[0-9]+)?/)) { print 0; exit }
        v = substr($0, RSTART + 1, RLENGTH - 1); rc = 999
        if (sub(/-rc/, " ", v)) { split(v, r, " "); rc = r[2]; v = r[1] }
        split(v, n, "."); printf "%d\n", ((n[1] * 1000 + n[2]) * 1000 + n[3]) * 1000 + rc }'
}
# latest: print "NAME P2_URL SHA_URL P2_BYTES" of the newest release's p2
# assets (GitHub lists an asset's size before its download URL).
latest() {
    curl -fsSL --max-time 30 -H 'Accept: application/vnd.github+json' "$api" |
        tr ',{}' '\n\n\n' | sed -n -e 's/^ *"size": *\([0-9]*\).*/size \1/p' \
            -e 's/^ *"browser_download_url": *"\([^"]*\)".*/url \1/p' |
        awk '$1 == "size" { z = $2 } $1 == "url" && $2 ~ /\.p2\.img\.gz$/ { g = $2; gz = z }
            $1 == "url" && $2 ~ /\.p2\.img\.sha256$/ { s = $2 }
            END { if (g == "" || s == "") exit 1; n = g; sub(/.*\//, "", n); sub(/\.p2\.img\.gz$/, "", n); print n, g, s, gz + 0 }'
}
# check: exit 0 and print "NAME P2_URL SHA_URL P2_BYTES" when a newer
# release is published; 1 when up to date, 2 when GitHub can't be read.
check() {
    [ -n "$repo" ] || [ -n "${MUOS_UPDATE_API:-}" ] || { echo 'no update repository configured' >&2; return 2; }
    out=$(latest) || { echo 'no release found' >&2; return 2; }
    # shellcheck disable=SC2086 # four words
    set -- $out
    [ "$(version "$1")" -gt "$(version "$release")" ] || { echo "up to date ($release; latest $1)"; return 1; }
    echo "$1 $2 $3 $4"
}
fetch() {
    out=$(check) || return $?
    # shellcheck disable=SC2086 # four words
    set -- $out
    lock
    name=$1 gz=$upd/$1.p2.img.gz
    [ ! -f "$gz" ] || [ ! -f "${gz%.gz}.sha256" ] || { echo "$name already downloaded"; return 0; }
    free=$(df -m /userdata | awk 'NR == 2 {print $4}')
    [ "$free" -ge 2800 ] || { log "update $name: need 2.8 GB free on the card (have ${free} MB)"; return 1; }
    for f in "$upd"/*.p2.img.gz.part; do [ ! -f "$f" ] || [ "$f" = "$gz.part" ] || rm -f "$f"; done
    log "downloading $name"
    curl -fsSL --max-time 30 -o "${gz%.gz}.sha256" "$3" || { log "download of $name failed (no sha256)"; return 1; }
    curl -fsSL --retry 2 --speed-limit 1024 --speed-time 60 -C - -o "$gz.part" "$2" ||
        { log "download of $name interrupted (resumed next time)"; return 1; }
    mv "$gz.part" "$gz"; log "downloaded $name"; sync
}
case ${1:-status} in
status)
    [ -f "$upd/pending" ] && echo "pending $(cat "$upd/pending")" || echo "idle (release ${release:-unknown})"
    ls "$upd"/*.p2.img.gz 2>/dev/null || : ;;
check) check ;;
fetch) fetch ;;
version) version "${2:-$release}" ;;
stage)
    lock
    on_trial && { echo 'an update is already being tried; restart first' >&2; exit 1; }
    # the highest version when several are there (else the newest file)
    img=$(ls -t "$upd"/*.p2.img.gz 2>/dev/null | while IFS= read -r f; do
        echo "$(version "${f##*/}") $f"; done | sort -s -n -r -k 1,1 | head -n 1 | cut -d' ' -f2-)
    [ -n "$img" ] || { echo "no NAME.p2.img.gz in $upd" >&2; exit 1; }
    want=$(cut -d' ' -f1 "${img%.gz}.sha256" 2>/dev/null) || :
    [ ${#want} = 64 ] || { echo "missing ${img##*/} sha256 (${img%.gz}.sha256)" >&2; exit 1; }
    free=$(df -m /userdata | awk 'NR == 2 {print $4}')
    [ "$free" -ge 2300 ] || { echo "need 2.3 GB free on the card (have ${free} MB)" >&2; exit 1; }
    power_ok || { echo 'battery below 30 %: connect the charger first' >&2; exit 1; }
    mkdir -p "$trial"; rm -f "$trial/rootfs.img"
    log "unpacking ${img##*/}"
    # one pass: unpack to the card and hash what was written
    got=$(gzip -dc "$img" | tee "$trial/rootfs.img.tmp" | sha256sum | cut -d' ' -f1)
    sync
    if [ "$got" != "$want" ]; then
        rm -f "$trial/rootfs.img.tmp" "$img" "${img%.gz}.sha256"
        log "sha256 mismatch ($got): update file removed"; echo 'the update file is damaged' >&2; exit 1
    fi
    mv "$trial/rootfs.img.tmp" "$trial/rootfs.img"
    echo "$want ${img##*/}" > "$upd/pending"
    mount -o remount,rw / && touch /etc/muos-root-trial; sync; mount -o remount,ro / 2>/dev/null || :
    log "staged ${img##*/} ($want), trial root armed"; sync ;;
finish) # the progress-screen task: write p2 now, progress lines on stdout
    [ -f "$upd/pending" ] && on_trial || { echo 'no update waiting on this start' >&2; exit 1; }
    : > /run/muos/update-finishing
    want=$(cut -d' ' -f1 "$upd/pending") img=$(cut -d' ' -f2 "$upd/pending")
    log "trial boot opened the frontend, writing p2"
    out=/run/muos/write-p2.out; : > "$out"
    # a shell loop, not grep: a pipe would hold the progress lines back
    $rt write-p2 "$trial/rootfs.img" "$want" 2>&1 | while IFS= read -r l; do
        echo "$l" >> "$out"; echo "$l" >> "$upd/update.log"
        case $l in progress\ *) echo "$l" ;; esac
    done
    if ! grep -q "^verified p2 sha256=$want" "$out"; then mv "$upd/pending" "$upd/failed"; log 'write-p2 failed'; exit 1; fi
    rm -f "$upd/pending" "$trial/rootfs.img" "$upd/$img" "$upd/${img%.gz}.sha256"
    log "installed $want"; sync
    : > /run/muos/update-finished
    /usr/libexec/muos-boot-sync arm --after-update > /dev/null 2>&1 || log 'kernel update not armed (see boot-sync lines)' ;;
resume)
    [ -f "$upd/pending" ] || exit 0
    want=$(cut -d' ' -f1 "$upd/pending") img=$(cut -d' ' -f2 "$upd/pending")
    if ! on_trial; then
        mv "$upd/pending" "$upd/failed"; log "update $want did not reach the menu: kept the old firmware"; exit 0
    fi
    [ ! -e /run/muos/update-finishing ] || exit 0 # the progress screen has it
    # Write p2 from the menu only (1 GiB of card writes stutter a game).
    until in_menu; do sleep 5; done
    [ ! -e /run/muos/update-finishing ] || exit 0
    : > /run/muos/update-finishing
    log "trial boot reached the menu, writing p2 (no progress screen)"
    $rt write-p2 "$trial/rootfs.img" "$want" >> "$upd/update.log" 2>&1 || { mv "$upd/pending" "$upd/failed"; log 'write-p2 failed'; exit 1; }
    rm -f "$upd/pending" "$trial/rootfs.img" "$upd/$img" "$upd/${img%.gz}.sha256"
    log "installed $want (running now; booted from p2 from the next start)"; sync
    /usr/libexec/muos-boot-sync arm --after-update > /dev/null 2>&1 || log 'kernel update not armed (see boot-sync lines)' ;;
*) sed -n '/^#   muos-update /p' "$0"; exit 2 ;;
esac
