#!/bin/sh
# SPDX-License-Identifier: MIT
# Port sleep/resume, after MustardOS internal/script/system/suspend.sh:
#   muxretro SIGUSR1 (save + pause, waits for muxretro_save_ready) -> backlight
#   off -> mute -> Wi-Fi/SSH down (8821cu unloaded, DWC2 unbound: the USB host
#   does not survive "mem" otherwise) -> /sys/power/state <- danger/state
#   (default mem); resume in reverse, muxretro SIGUSR2 last. As upstream
#   (module load waited for before the game resumes), the game stays paused
#   until the Wi-Fi radio is up again (USB enumeration, 8821cu, firmware:
#   2-3 s of IRQ/kworker load that stalled frames, M3d), at most 6 s, and
#   not at all while the dongle settles in CD-ROM mode (M4b); association
#   and DHCP continue in the background.
# M8 (M7 T3: a libretro game stuttered for a while after the wake): woken
# in a game, Wi-Fi stays down until the game ends (the dongle's CD-ROM
# settle, mode switch and 8821cu firmware load land 4-8 s after the wake,
# in the middle of play); nothing in a game needs the network. A watcher
# brings it up when the game process exits; network/deferred keeps the USB
# watchdog from binding dwc2 meanwhile. T2 hook: /run/muos/wifi-wake-in-game
# (the old behaviour, SSH back during the game).
# settings/power/shutdown (upstream default 600): seconds asleep before a
# clean poweroff through init (RTC alarm); -1 sleep until woken; 2 power
# off instead of sleeping. Charger connected: "fake sleep" (screen off,
# frontend/muxretro/mupen64plus stopped, wake on the Power key), timer
# ignored, as upstream. Test hooks: --test-wake SECONDS or /run/muos/suspend-test-wake.
export PATH=/opt/muos/frontend:/usr/sbin:/usr/bin:/sbin:/bin
run=/run/muos
log=/opt/muos/log/suspend.log
bl=/sys/class/backlight/backlight/brightness
gov=/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
rtc=/sys/class/rtc/rtc0
dwc2=/sys/bus/platform/drivers/dwc2
usb=ff300000.usb
exec >> "$log" 2>&1
say() { printf '%s %s\n' "$(cut -d' ' -f1 /proc/uptime)" "$*"; }
cfg() { v=$(cat "/opt/muos/config/$1" 2>/dev/null); echo "${v:-$2}"; }
test_wake=; [ "${1:-}" = --test-wake ] && test_wake=$2
# T2 hook: /run/muos/suspend-test-wake (seconds) makes key-triggered sleeps
# wake on the RTC so cycles can run unattended.
[ -n "$test_wake" ] || [ ! -s /run/muos/suspend-test-wake ] || test_wake=$(cat /run/muos/suspend-test-wake)

exec 9>"$run/suspend.lock"
flock -n 9 || { say "ignored: another sleep holds the lock"; exit 0; }
[ ! -e "$run/recent_wake" ] || { say "ignored: recent wake"; exit 0; }
: > "$run/recent_wake"
# However this run ends, re-arm sleep a few seconds later.
trap '( sleep 6; rm -f "$run/recent_wake" ) 9>&- &' EXIT

# M8 (M8 T3 5): the press must read as instant. Before anything slow (the
# process scans, muxretro's auto-save of ~1.3 s, the Wi-Fi stop): screen
# off and a standalone emulator stopped first, sound muted next. dArkOSen
# blanks first too ("so it seems like sleep enters quicker", sleep.rk3326).
bright=$(cat "$bl"); [ "$bright" -gt 0 ] 2>/dev/null || bright=$(cfg settings/general/brightness 60)
echo 0 > "$bl"
sa=$(for p in /proc/[0-9]*; do
    case "$(readlink "$p/exe")" in
        */emulator/mupen64plus/mupen64plus|*/PPSSPPSDL|*/drastic) echo "${p#/proc/}" ;;
    esac
done | head -n1)
[ -z "$sa" ] || kill -STOP "$sa"
wpctl set-mute @DEFAULT_AUDIO_SINK@ 1 2>/dev/null
say "screen off"

state=$(cfg danger/state mem)
shutdown=$(cfg settings/power/shutdown 600)
charger=$(cat "$(cat /opt/muos/device/config/battery/charger 2>/dev/null || echo /sys/class/power_supply/ac/online)" 2>/dev/null || echo 0)
fake=0; [ "$charger" = 1 ] && [ -z "$test_wake" ] && { fake=1; shutdown=-1; }
[ -z "$test_wake" ] || shutdown=-1
say "sleep state=$state shutdown=$shutdown charger=$charger"

pid_of() { for p in /proc/[0-9]*; do [ "$(readlink "$p/exe")" = "/opt/muos/frontend/$1" ] && echo "${p#/proc/}"; done; }
retro=$(pid_of muxretro | head -n1)
# M7: the standalone N64 emulator (muos-mupen64plus) has no save hook; it is
# stopped while asleep (above, $sa) and continued where muxretro gets
# SIGUSR2. M8: also standalone PPSSPP and DraStic.
save_retro() {
    [ -n "$retro" ] || return 0
    rm -f "$run/muxretro_save_ready"
    kill -USR1 "$retro" 2>/dev/null || return 0
    n=0
    while [ "$n" -lt 100 ]; do
        [ "$(cat "$run/muxretro_save_ready" 2>/dev/null)" = "$retro" ] && { say "muxretro saved"; break; }
        kill -0 "$retro" 2>/dev/null || break
        sleep 0.05; n=$((n+1))
    done
    rm -f "$run/muxretro_save_ready"
}

# M4f: Activity (playtime) of the running game, as upstream suspend.sh
# ACTIVITY_TRACKER: paused while asleep, closed on a poweroff.
track_event() { # suspend|resume|stop [END]
    [ -n "$retro$sa" ] || return 0
    t=/run/muos/storage/info/track/.current_session
    [ -r "$t" ] || return 0
    { read -r t_name; read -r t_core; read -r t_rom; } < "$t"
    [ -n "$t_rom" ] || return 0
    TRACK_END=${2:-} /opt/muos/script/mux/track.sh "$t_name" "$t_core" "$t_rom" "$1" > /dev/null 2>&1 9>&- || :
}

deferred=/run/muos/network/deferred
stop_watcher() {
    [ -s "$run/net-deferred.pid" ] && kill "$(cat "$run/net-deferred.pid")" 2>/dev/null
    rm -f "$run/net-deferred.pid"
}

if [ "$shutdown" = 2 ]; then
    save_retro
    track_event stop poweroff
    say "shutdown=2: power off instead of sleeping"
    poweroff 9>&-; exit 0
fi

# ---- SLEEP
stop_watcher # a new one starts at the wake if a game still runs
save_retro
track_event suspend
saved_gov=$(cat "$gov")

net_down() {
    /etc/init.d/S41muos-network stop >/dev/null 2>&1
    rmmod 8821cu 2>/dev/null
    [ -e "$dwc2/$usb" ] && echo "$usb" > "$dwc2/unbind"
}
net_up() {
    rm -f /run/muos/network/radio /run/muos/network/idle
    [ -e "$dwc2/$usb" ] || echo "$usb" > "$dwc2/bind"
    # Close the lock fd: the daemons started here outlive this script.
    /etc/init.d/S41muos-network start >/dev/null 2>&1 9>&-
}
wait_radio() {
    n=0 why=
    # idle: no Wi-Fi network configured or the menu's Wi-Fi toggle off, the
    # worker leaves the radio off.
    # M4b: "mem" cuts the dongle's power; back in CD-ROM mode it must settle
    # before the switch (worker, 4 s since M4c), so waiting gains nothing:
    # the game resumes now (the later bring-up costs ~0.7 s of slow frames,
    # CPU3).
    while [ "$n" -lt 60 ] && [ ! -e /run/muos/network/radio ] && [ ! -e /run/muos/network/idle ]; do
        grep -qx 1a2b /sys/bus/usb/devices/*/idProduct 2>/dev/null && { why=' (dongle settling)'; break; }
        sleep 0.1; n=$((n+1))
    done
    say "radio $([ -e /run/muos/network/radio ] && echo up || { [ -e /run/muos/network/idle ] && echo idle; } || echo 'not up') after $((n / 10)).$((n % 10)) s$why"
}

if [ "$fake" = 1 ]; then
    say "fake sleep (charging): wait for Power"
    pids="$(pid_of muxfrontend) $retro"
    # shellcheck disable=SC2086  # list of PIDs
    [ -z "${pids% }" ] || kill -STOP $pids
    /usr/libexec/muos-governor powersave
    dev=$(grep -l '^rk8xx_pwrkey$' /sys/class/input/event*/device/name | head -n1)
    node=/dev/input/${dev#/sys/class/input/}; node=${node%/device/name}
    # struct input_event (24 B): wait for EV_KEY KEY_POWER (116) press.
    while :; do
        ev=$(dd if="$node" bs=24 count=1 2>/dev/null | od -An -tu2 | tr -s ' ')
        # shellcheck disable=SC2086  # one field per word
        set -- $ev
        [ "${9:-}" = 1 ] && [ "${10:-}" = 116 ] && [ "${11:-}" = 1 ] && break
    done
    # shellcheck disable=SC2086
    [ -z "${pids% }" ] || kill -CONT $pids
else
    net_down
    deadline=0
    echo 0 > "$rtc/wakealarm"
    if [ -n "$test_wake" ]; then
        echo "+$test_wake" > "$rtc/wakealarm"
    elif [ "$shutdown" -gt 0 ] 2>/dev/null; then
        deadline=$(( $(cat "$rtc/since_epoch") + shutdown ))
        echo "$deadline" > "$rtc/wakealarm"
    fi
    sync
    /usr/libexec/muos-rumble-setup event sleep 2>/dev/null || : # M4e
    say "suspend to $state"
    echo "$state" > /sys/power/state || say "suspend refused"
    echo 0 > "$rtc/wakealarm"
    say "woke (rtc $(cat "$rtc/since_epoch"), deadline $deadline)"
    if [ "$deadline" -gt 0 ] && [ "$(cat "$rtc/since_epoch")" -ge "$deadline" ]; then
        say "shutdown timer reached: power off"
        track_event stop poweroff
        poweroff 9>&-; exit 0
    fi
fi

# ---- RESUME
/usr/libexec/muos-governor "$saved_gov"
echo "$bright" > "$bl"
defer=0
if [ "$fake" != 1 ]; then
    if [ -n "$retro$sa" ] && [ ! -e "$run/wifi-wake-in-game" ]; then
        defer=1
        mkdir -p "${deferred%/*}"; : > "$deferred"
        say "Wi-Fi deferred until the game ends"
    else
        rm -f "$deferred"
        net_up
        [ -z "$retro$sa" ] || wait_radio
    fi
fi
# M8 (M8 T3 5: micro stutters right after the wake): an optional hold of
# the paused game, settings/power/wake_hold in ms (T2 hook
# /run/muos/wake-hold). Default 0 since the m8b T3 (the 3 s hold felt
# slow): the stutters came from the slot-2 card's resume rescan spinning on
# CPU0 (kernel patch 0010 + the CPU1-3 pin below); t2-wake-frames.sh, NES,
# 3 wakes: 2-4 frames of 21-27 ms, was ~10 of up to 75-238 ms.
hold=$(cat "$run/wake-hold" 2>/dev/null || cfg settings/power/wake_hold 0)
case "$hold" in ''|*[!0-9]*) hold=0 ;; esac
if [ -n "$retro$sa" ] && [ "$hold" -gt 0 ]; then
    say "hold ${hold} ms"
    sleep "$((hold / 1000)).$(printf '%03d' $((hold % 1000)))"
fi
wpctl set-mute @DEFAULT_AUDIO_SINK@ 0 2>/dev/null
# The game resumes on CPU0-2, away from the 8821cu association (CPU3).
# M8 (wake stutter, kernel patch 0010): with Wi-Fi deferred CPU3 is free,
# while CPU0 runs the resume rescans (a slot-2 card that fails to
# initialise spins there for ~3 s and holds up CPU0's work items, the page
# flips queued from CPU0 among them): CPU1-3 first, all four after 5 s.
mask=7; [ "$defer" = 1 ] && mask=e
[ -z "$retro" ] || /usr/libexec/muos-cpu-pin $mask "$retro"
[ -z "$retro" ] || kill -USR2 "$retro" 2>/dev/null
[ -z "$sa" ] || { /usr/libexec/muos-cpu-pin $mask "$sa"; kill -CONT "$sa" 2>/dev/null; }
if [ "$defer" = 1 ]; then
    ( sleep 5; [ -e "$deferred" ] && /usr/libexec/muos-cpu-pin f $retro $sa ) 9>&- &
fi
( track_event resume ) 9>&- &
if [ "$defer" = 1 ]; then
    game=${retro:-$sa}
    (
        while kill -0 "$game" 2>/dev/null; do sleep 1; done
        exec 9>"$run/suspend.lock"; flock 9 # after any sleep in progress
        if [ -e "$deferred" ]; then
            rm -f "$deferred"
            say "game ended: Wi-Fi up"
            net_up
        fi
        rm -f "$run/net-deferred.pid"
    ) 9>&- &
    echo $! > "$run/net-deferred.pid"
fi
cut -d' ' -f1 /proc/uptime > "$run/input_resume"
say "resumed"
