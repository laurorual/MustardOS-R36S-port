#!/bin/sh
# SPDX-License-Identifier: MIT
# Headphone switching, after MustardOS internal/script/device/headphone.sh
# (RK817 G350 branch): follow the ASoC "Headphone Jack" control and set the
# RK817 "Playback Path": jack in -> HP, jack out -> the device default
# (device/config/audio/path, SPK_HP on this unit). Polarity: on = inserted
# (confirmed at M2 T3); device/config/audio/jack_inverted=1 flips it.
#
# Per-output volume, as upstream SWITCH_OUTPUT_VOLUME: /run/muos/headphones
# (the muOS flag) makes muOS audio.sh save volume changes under
# "<sink> (Headphones)", so the speaker and the headphones each keep their
# own level. The HP output has no class-D amp and is much quieter than the
# speaker at the same level. On a switch the outgoing level is saved and
# the incoming output's level is restored. Calls muOS's own helpers at run
# time (GPL-3, not copied).
. /opt/muos/script/var/audio.sh
say() { printf '%s %s\n' "$(cut -d' ' -f1 /proc/uptime)" "$*"; }
default=$(cat /opt/muos/device/config/audio/path 2>/dev/null); default=${default:-SPK_HP}
jack() {
    # Re-read each poll: flipping it on the tmpfs device config simulates a
    # plug/unplug for T2 (t2-headphone.sh).
    inv=$(cat /opt/muos/device/config/audio/jack_inverted 2>/dev/null)
    v=$(amixer -c 0 cget iface=CARD,name='Headphone Jack' 2>/dev/null | sed -n 's/.*: values=//p')
    case "$v:$inv" in on:1|off:1) [ "$v" = on ] && echo 0 || echo 1 ;; on:*) echo 1 ;; off:*) echo 0 ;; *) echo x ;; esac
}
on_builtin() {
    b=$(cat "$AUDIO_BUILTIN_FILE" 2>/dev/null)
    [ -n "$b" ] && [ "$(CURRENT_SINK_NAME)" = "$b" ]
}
# $1 = 1 headphones / 0 speaker, $2 = 1 on the first pass (nothing to save:
# the level in use came from settings/general/volume at boot).
switch_volume() {
    builtin=0; on_builtin && builtin=1
    [ "$builtin" = 1 ] && [ "$2" = 0 ] && SAVE_SINK_VOLUME >/dev/null 2>&1
    if [ "$1" = 1 ]; then : > "$HEADPHONE_FLAG"; else rm -f "$HEADPHONE_FLAG"; fi
    [ "$builtin" = 1 ] || return 0
    if LOAD_SINK_VOLUME >/dev/null 2>&1; then
        level=$(GET_SAVED_AUDIO_VOLUME)
        wpctl set-volume @DEFAULT_AUDIO_SINK@ "${level}%" 2>/dev/null && say "volume ${level}% restored"
    else
        SAVE_SINK_VOLUME >/dev/null 2>&1
    fi
}
last= first=1
while :; do
    now=$(jack)
    if [ "$now" != x ] && [ "$now" != "$last" ]; then
        if [ "$now" = 1 ]; then path=HP; else path=$default; fi
        switch_volume "$now" "$first"
        amixer -q -c 0 sset 'Playback Path' "$path" 2>/dev/null && say "jack=$now path=$path" || say "jack=$now path $path refused"
        last=$now first=0
    fi
    sleep 1
done
