#!/bin/sh
# SPDX-License-Identifier: MIT
# Low battery, after MustardOS internal/script/system/lowpower.sh: every 10 s,
# when not charging and capacity <= settings/power/low_battery, show the
# battery overlay (/run/muos/overlay.battery). Port addition: at or below
# CRITICAL % (default 3) for three checks in a row while discharging, power
# off cleanly through init (saves, p3) before the PMIC cuts power, and
# only if the battery voltage agrees (below VOLTAGE mV, default 3500): a
# gauge error must not power off a charged battery (M3d step 2 T3: 0% shown
# at 4.1 V). M4a: before the poweroff the UI is stopped (as the poweroff
# would) and the "battery empty" splash shown for 3 s; muos-rc stop shows
# it again at the end (/run/muos/battery-empty).
# M4d: critical 3 -> 1% (the BSP zero algorithm brings the % to 0 when
# the loaded voltage reaches power_off_thresd, 3300 mV, at the present
# load; at 3% a CTR run still had ~2-3 min), and the guard judges the
# current-corrected voltage (open-circuit estimate V + I x 200 mOhm,
# below VOLTAGE mV, default 3550 = ~15% on the OCV table): under a game
# load the plain voltage reads 3.45 V at ~15%, so the old 3500 mV guard
# would have let a gauge error power off a battery with charge left.
# The kernel (ODROIDGOA) still powers off by itself below 3300 mV.
run=${MUOS_RUN_DIR:-/run/muos}
bat=${MUOS_BATTERY_SYSFS:-/sys/class/power_supply/battery}
cfgdir=${MUOS_CONFIG_DIR:-/opt/muos/config}
cap=$run/battery/capacity chg=$run/battery/charging ovl=$run/overlay.battery
critical=${MUOS_BATTERY_CRITICAL:-1} interval=${MUOS_BATTERY_INTERVAL:-10}
volt=${MUOS_BATTERY_VOLTAGE:-3550} res=${MUOS_BATTERY_RES_MOHM:-200}
bat_mv() { v=$(cat "$bat/voltage_now" 2>/dev/null); echo $(( ${v:-0} / 1000 )); }
# Open-circuit estimate: the discharge current (current_now < 0) times res.
ocv_mv() {
    i=$(cat "$bat/current_now" 2>/dev/null); i=$(( ${i:-0} / 1000 ))
    [ "$i" -lt 0 ] || i=0
    echo $(( $(bat_mv) - i * res / 1000 ))
}
say() { printf '%s %s\n' "$(cut -d' ' -f1 /proc/uptime)" "$*"; }
cfg() { v=$(cat "$cfgdir/$1" 2>/dev/null); echo "${v:-$2}"; }
empty() {
    if [ -n "${MUOS_BATTERY_EMPTY_CMD:-}" ]; then $MUOS_BATTERY_EMPTY_CMD; return; fi
    : > "$run/battery-empty"; sync
    /etc/init.d/S99muos-ui stop
    /usr/libexec/muos-splash && sleep 3
    poweroff
}
until [ -f "$cap" ] && [ -f "$chg" ]; do sleep 2; done
low=0 ignored=
while :; do
    c=$(cat "$cap" 2>/dev/null); g=$(cat "$chg" 2>/dev/null)
    case "$c:$g" in *[!0-9:]*|:*|*:) sleep "$interval"; continue ;; esac
    if [ "$g" -ne 0 ] || [ "$c" -gt "$(cfg settings/power/low_battery 25)" ]; then
        [ ! -e "$ovl" ] || { rm -f "$ovl"; say "battery ok ($c%, charging=$g)"; }
        low=0 ignored=
    else
        [ -e "$ovl" ] || { : > "$ovl"; say "low battery warning ($c%)"; }
        if [ "$c" -le "$critical" ] && [ "$(ocv_mv)" -lt "$volt" ]; then
            low=$((low + 1))
            [ "$low" -lt 3 ] || { say "critical battery ($c%, $(bat_mv) mV, corrected $(ocv_mv) mV): power off"; empty; exit 0; }
        elif [ "$c" -le "$critical" ]; then
            [ -n "$ignored" ] || say "critical $c% ignored: battery at $(bat_mv) mV, corrected $(ocv_mv) mV"
            low=0 ignored=1
        else
            low=0
        fi
    fi
    sleep "$interval"
done
