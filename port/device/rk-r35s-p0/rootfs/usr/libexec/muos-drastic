#!/bin/sh
# SPDX-License-Identifier: MIT
# muos-drastic ROM: DraStic (NDS, decision 23: the fastest emulator, closed
# source allowed; dArkOSen's default for NDS), run by muos-frontend for the
# NDS "ext-drastic" assignment, with trngaje's advanced_drastic hook (M8 T3
# 6; upstream muOS's "drastic-trngaje"): screen layouts with background art
# (default "vh_s0": top screen big at the top left, touch screen small at
# the bottom right), its own menu, auto save state on exit (also on
# SIGTERM, i.e. Fn+Start) and auto load on start.
# DraStic keeps everything in its working directory (config/, backup/
# saves, savestates/, cheats/, slot2/, ...): p3 MUOS/port/drastic (the
# saves of the plain DraStic of m8b stay). The image's binary, BIOS
# replacements and game database (/opt/muos/share/emulator/drastic,
# build-drastic.sh stage-adv) are copied in when they differ; resources/
# links the image's art and fonts, its settings.json is the user's.
# Settings: /usr/share/muos-r35s/drastic-trngaje/drastic.cfg once (the
# m8b plain-DraStic drastic.cfg is kept as drastic.cfg.plain), then the
# user's (DraStic's menu writes it).
# Keys (upstream muOS's mapping): Fn = hotkey: Fn+X menu, Fn+Start quit,
# Fn+Left/Right layout, Fn+Y background, Fn+L2/R2 load/save state, Fn+R1
# fast forward, Fn+B smooth/pixel, Fn+L1 d-pad as stylus; R2 swaps the
# screens, right stick = stylus, R3 = touch, L3 = microphone (M8d T3).
# Video: SDL's KMSDRM renderer needs vsync here (without it the page flip
# fails with -22 and the screen stays black, M8 night 1).
# Sleep: muos-suspend stops and continues the process.
set -u
emu=/opt/muos/share/emulator/drastic
w=/userdata/MUOS/port/drastic
rom=${1:?rom}
say() { echo "muos-drastic: $*"; }
mkdir -p "$w/config" "$w/system" "$w/resources" || exit 1
for d in backup savestates cheats slot2 profiles input_record scripts unzip_cache; do
    mkdir -p "$w/$d"
done
for f in drastic game_database.xml system/drastic_bios_arm7.bin system/drastic_bios_arm9.bin; do
    if ! cmp -s "$emu/$f" "$w/$f"; then
        { cp "$emu/$f" "$w/$f.new" && mv -f "$w/$f.new" "$w/$f"; } || say "copy of $f failed"
    fi
done
chmod 755 "$w/drastic"
for d in font lang menu pen bg; do
    [ "$(readlink "$w/resources/$d")" = "$emu/resources/$d" ] || { rm -rf "$w/resources/$d"; ln -s "$emu/resources/$d" "$w/resources/$d"; }
done
[ "$(readlink "$w/microphone")" = "$emu/microphone" ] || { rm -rf "$w/microphone"; ln -s "$emu/microphone" "$w/microphone"; }
[ -s "$w/resources/settings.json" ] || cp /usr/share/muos-r35s/drastic-trngaje/settings.json "$w/resources/settings.json"
if [ ! -e "$w/config/.muos-advanced" ]; then
    [ -f "$w/config/drastic.cfg" ] && mv -f "$w/config/drastic.cfg" "$w/config/drastic.cfg.plain"
    cp /usr/share/muos-r35s/drastic-trngaje/drastic.cfg "$w/config/drastic.cfg" && : > "$w/config/.muos-advanced"
fi
[ -s "$w/config/drastic.cfg" ] || cp /usr/share/muos-r35s/drastic-trngaje/drastic.cfg "$w/config/drastic.cfg"
# M8c T3 4: the stylus moves to the right stick (a2/a3), the vertical d-pad
# to the left one; once in a config written before that.
if [ ! -e "$w/config/.muos-rstick" ]; then
    sed -i -e 's/^\(controls_b\[CONTROL_INDEX_TOUCH_CURSOR_UP\] = \).*/\11219/' \
        -e 's/^\(controls_b\[CONTROL_INDEX_TOUCH_CURSOR_DOWN\] = \).*/\11155/' \
        -e 's/^\(controls_b\[CONTROL_INDEX_TOUCH_CURSOR_LEFT\] = \).*/\11218/' \
        -e 's/^\(controls_b\[CONTROL_INDEX_TOUCH_CURSOR_RIGHT\] = \).*/\11154/' \
        -e 's/^\(controls_b\[CONTROL_INDEX_VERTICAL_UP\] = \).*/\11216/' \
        -e 's/^\(controls_b\[CONTROL_INDEX_VERTICAL_DOWN\] = \).*/\11152/' \
        -e 's/^\(controls_b\[CONTROL_INDEX_VERTICAL_LEFT\] = \).*/\11153/' \
        -e 's/^\(controls_b\[CONTROL_INDEX_VERTICAL_RIGHT\] = \).*/\11217/' "$w/config/drastic.cfg" &&
        : > "$w/config/.muos-rstick"
fi
# M8d T3 (the user): the stylus touches with R3, the fake microphone moves
# to L3; once (the user's own R3 setting stays).
if [ ! -e "$w/config/.muos-r3touch" ]; then
    sed -i -e 's/^\(controls_b\[CONTROL_INDEX_TOUCH_CURSOR_PRESS\] = \)1035$/\11036/' \
        -e 's/^\(controls_b\[CONTROL_INDEX_FAKE_MICROPHONE\] = \)1036$/\11035/' "$w/config/drastic.cfg" &&
        : > "$w/config/.muos-r3touch"
fi
# M8c T3 5: an empty temp state left by a killed save
[ -s "$w/savestates/_savestate_temp.dss" ] || rm -f "$w/savestates/_savestate_temp.dss"
say "start rom=$rom"
cd "$w" || exit 1
pre=$emu/libs/libadvdrastic.so
# T2 hook (t2-swapstat.sh): frame timing, only with a test-pushed /run file
[ -e /run/muos/perf-capture ] && [ -f /run/muos/swapstat.so ] && pre="$pre:/run/muos/swapstat.so"
LD_LIBRARY_PATH=$emu/libs${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH} LD_PRELOAD=$pre \
    SDL_RENDER_VSYNC=1 HOME=$w exec ./drastic "$rom"
