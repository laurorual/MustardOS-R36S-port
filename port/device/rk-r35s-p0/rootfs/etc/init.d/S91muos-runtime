#!/bin/sh
# SPDX-License-Identifier: MIT
# Writable views the muOS frontend needs on a read-only root:
#   p3 MUOS/port/config        -> /opt/muos/config         (user settings)
#   p3 MUOS/port/volume        -> /opt/muos/share/volume   (per-output volume)
#   p3 MUOS/port/info-content  -> /opt/muos/share/info/content (core assigns)
#   p3 MUOS/port/info-config   -> /opt/muos/share/info/config
#   tmpfs copy                 -> /opt/muos/device/config  (sdl_map etc.)
#   tmpfs copy                 -> /usr/share/wireplumber, /root
#   tmpfs copy                 -> /etc/asound.conf, /usr/share/alsa/alsa.conf
#                                 seeded from the muOS templates in
#                                 share/conf/rootfs, so S80pipewire.sh finds
#                                 them equal (its cp -f cannot replace a bind)
#   p3 MUOS/log/system         -> /opt/muos/log (previous boots in system.prev, .prev2, .prev3)
# ROMS/<DIR> and default core assignments come from
# /usr/share/muos-r35s/core-assign.txt (only folders without one, M3c).
# p3 state is seeded once from the rootfs (which carries the R35S profile)
# and imports the C21 preferences store (VOLUME/BRIGHTNESS). cpufreq is
# writable (M2): the frontend loop applies muOS per-content governors;
# /sys/power is written by muos-suspend (M2). Config keys added to the
# rootfs later (e.g. the M2 power defaults) are copied into an existing p3
# config without touching values the user already has.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
port=/userdata/MUOS/port
rw=/run/muos/rw
state=/run/muos/runtime
mkdir -p "$state"
bind() {
    mkdir -p "$1"
    findmnt -rn -M "$2" >/dev/null && return 0
    mount --bind "$1" "$2" && printf '%s\n' "$2" >> "$state/mounts"
}
seed() {
    [ -e "$port/.seeded" ] && return 0
    rm -rf "$port.tmp"; mkdir -p "$port.tmp"
    cp -a /opt/muos/config "$port.tmp/config"
    cp -a /opt/muos/share/volume "$port.tmp/volume"
    prefs=/userdata/MUOS/preferences
    if [ -d "$prefs" ] && out=$(/usr/libexec/muos-session/bin/muos-preferences --dir "$prefs" load 2>/dev/null); then
        v=$(printf '%s\n' "$out" | sed -n 's/^VOLUME=//p')
        b=$(printf '%s\n' "$out" | sed -n 's/^BRIGHTNESS=//p')
        case "$v:$b" in *[!0-9:]*|:*|*:) ;; *)
            printf '%s\n' "$v" > "$port.tmp/config/settings/general/volume"
            printf '%s\n' "$b" > "$port.tmp/config/settings/general/brightness"
            printf '0\n' > "$port.tmp/config/settings/advanced/volume"
            for slot in "$port.tmp/volume"/*; do [ -f "$slot" ] && printf '%s\n' "$v" > "$slot"; done
            echo "runtime: imported prefs volume=$v brightness=$b" ;;
        esac
    fi
    sync
    rm -rf "$port"; mv "$port.tmp" "$port"; touch "$port/.seeded"; sync
}
case "${1:-}" in
 start)
    findmnt -rn -M /userdata >/dev/null || { echo 'runtime: /userdata missing' >&2; exit 1; }
    : > "$state/mounts"
    seed
    (cd /opt/muos/config && find . -type f) | while read -r f; do
        [ -e "$port/config/$f" ] && continue
        mkdir -p "$port/config/${f%/*}"; cp -p "/opt/muos/config/$f" "$port/config/$f"; echo "runtime: added config $f"
    done
    # One-shot fixes of values earlier port images seeded wrong (each runs
    # once per card, then the user's choice wins).
    # battery-visible: the Phase 3 profile hid the status-bar battery
    # (visual/battery 3); upstream default is 2 (icon + percent).
    mig=$port/.migrations; touch "$mig"
    if ! grep -qx battery-visible "$mig"; then
        if [ "$(cat "$port/config/visual/battery" 2>/dev/null)" = 3 ]; then
            printf '2\n' > "$port/config/visual/battery"; echo 'runtime: migrated visual/battery 3 -> 2'
        fi
        echo battery-visible >> "$mig"; sync
    fi
    # M3c: default ROM folders + core assignments for installed cores.
    grep -v '^#' /usr/share/muos-r35s/core-assign.txt 2>/dev/null |
    while IFS='|' read -r dir core sys launch; do
        [ -n "$dir" ] && [ -f "/opt/muos/share/core/$core" ] || continue
        mkdir -p "/userdata/ROMS/$dir"
        c=$port/info-content/$dir
        [ -e "$c/core.cfg" ] && continue
        mkdir -p "$c"
        printf '%s\n%s\n%s\n0\n%s\n' "$core" "$sys" "$sys" "$launch" > "$c/core.cfg"
        echo system > "$c/core.con"; echo performance > "$c/core.gov"; echo false > "$c/core.rac"
        echo "runtime: assigned $dir -> $core"
    done
    # game-governor (M3d): M3c seeded schedutil, which idles at the 1008 MHz
    # floor through per-frame bursts (PSX 59.1 fps, missed vsyncs); games
    # now default to performance (muos-governor also pins GPU and DDR).
    # Only the seeded value is replaced; any other choice stays.
    if ! grep -qx game-governor "$mig"; then
        for g in "$port"/info-content/core.gov "$port"/info-content/*/core.gov; do
            [ -f "$g" ] && [ "$(tr -d ' \n' < "$g")" = schedutil ] || continue
            echo performance > "$g"; echo "runtime: migrated ${g#"$port"/} schedutil -> performance"
        done
        echo game-governor >> "$mig"; sync
    fi
    bind "$port/config" /opt/muos/config
    bind "$port/volume" /opt/muos/share/volume
    bind "$port/info-content" /opt/muos/share/info/content
    bind "$port/info-config" /opt/muos/share/info/config
    mkdir -p "$rw"
    mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs "$rw"
    cp -a /opt/muos/device/config "$rw/device-config"
    cp -a /usr/share/wireplumber "$rw/wireplumber"
    mkdir -m 700 "$rw/home"
    bind "$rw/device-config" /opt/muos/device/config
    bind "$rw/wireplumber" /usr/share/wireplumber
    bind "$rw/home" /root
    for file in /etc/asound.conf /usr/share/alsa/alsa.conf; do
        copy=$rw/files$file
        mkdir -p "${copy%/*}"
        template=/opt/muos/share/conf/rootfs/${file##*/}
        if [ -f "$template" ]; then cp "$template" "$copy"; elif [ -e "$file" ]; then cp -p "$file" "$copy"; fi
        [ -e "$copy" ] || : > "$copy"
        [ -e "$file" ] || continue
        mount --bind "$copy" "$file" && printf '%s\n' "$file" >> "$state/mounts"
    done
    logs=/userdata/MUOS/log
    # Keep three previous boots: a T3 round often spans several reboots.
    rm -rf "$logs/system.prev3"
    [ ! -d "$logs/system.prev2" ] || mv "$logs/system.prev2" "$logs/system.prev3"
    [ ! -d "$logs/system.prev" ] || mv "$logs/system.prev" "$logs/system.prev2"
    [ ! -d "$logs/system" ] || mv "$logs/system" "$logs/system.prev"
    bind "$logs/system" /opt/muos/log
    touch "$state/ready"
    ;;
 stop)
    rm -f "$state/ready"
    # muOS log helper started by S80pipewire.sh keeps /opt/muos/log open.
    killall mulog 2>/dev/null && sleep 0.3
    sync
    [ -r "$state/mounts" ] && for dest in $(sed '1!G;h;$!d' "$state/mounts"); do umount "$dest" || umount -l "$dest"; done
    ! findmnt -rn -M "$rw" >/dev/null || umount "$rw" || umount -l "$rw"
    : > "$state/mounts"
    ;;
 status) [ -e "$state/ready" ] ;;
 *) echo 'Usage: S91muos-runtime start|stop|status' >&2; exit 2 ;;
esac
