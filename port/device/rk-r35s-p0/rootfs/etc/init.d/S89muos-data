#!/bin/sh
# SPDX-License-Identifier: MIT
# Mount p3 (MUOSDATA) rw at /userdata and p1 (FAT) ro at /boot.
# Before mounting, p3 is checked (ext4: `e2fsck -p`, journal replay, a full
# pass only if the filesystem is flagged with errors; M13: exFAT `fsck.exfat
# -p`, FAT32 `fsck.fat -a -w`), bounded to 100 s. Any result still mounts p3
# so the UI comes up; the outcome is kept in p3 MUOS/log/fsck-p3.log (exit
# 4 = needs a manual fsck, 124 = timed out).
# First boot of a freshly written image: muos-grow-p3 grows p3 to the
# whole card (partition before the mount, ext4 online after it; no-ops
# afterwards; log p3 MUOS/log/grow-p3.log). M13 (decision 50): not on a
# public image (rootfs boot/factory_reset 1): there the first boot's Install
# asks for a format (ext4, exFAT or FAT32) and the next start applies it
# here, before anything else uses p3 (muos-install-storage apply: grows p3,
# formats it, puts the first boot's settings back).
# stop: keep the rc log on p3 (MUOS/log/rc-last.log) and the boot's Wi-Fi
# logs (MUOS/log/network-last.log, M4e), sync, unmount.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
disk=/dev/disk/by-partuuid/4d554432
data=/userdata
part() {
    # M5: the slot 1 card by controller (a copy of the image in slot 2 has
    # the same disk id), the by-partuuid link only as a fallback
    d=$(/usr/libexec/muos-boot-disk) && { echo "${d}p$1"; return; }
    echo "$disk-0$1"
}
# mount_p3: by its filesystem (M13), the checker first
mount_p3() {
    p3=$(part 3)
    t=$(blkid -o value -s TYPE "$p3" 2>/dev/null) || :
    case $t in
        exfat) modprobe -q exfat || :; chk="fsck.exfat -p"
            o=uid=0,gid=0,fmask=0022,dmask=0022,iocharset=utf8,errors=remount-ro ;;
        vfat) chk="fsck.fat -a -w" o=uid=0,gid=0,fmask=0022,dmask=0022,utf8,shortname=mixed,errors=remount-ro ;;
        *) t=ext4 chk="e2fsck -p" o=data=ordered ;;
    esac
    fsck=
    if command -v "${chk%% *}" >/dev/null; then
        t0=$(cut -d' ' -f1 /proc/uptime)
        # shellcheck disable=SC2086 # the checker and its flags
        out=$(/usr/libexec/muos-run-bounded 100 $chk "$p3" 2>&1); rc=$?
        fsck="$t0 $chk rc=$rc took=$(awk -v a="$t0" '{print $1 - a}' /proc/uptime)s
$out"
        case $rc in 0|1) ;; *) echo "data: ${chk%% *} rc=$rc, mounting anyway" ;; esac
    fi
    mount -t "$t" -o "rw,noatime,nosuid,nodev,$o" "$p3" "$data"
}
case "${1:-}" in
 start)
    mkdir -p "$data" /boot
    n=0; while [ ! -b "$(part 3)" ] && [ "$n" -lt 50 ]; do sleep 0.1; n=$((n+1)); done
    fsck=
    grow=1; [ "$(cat /opt/muos/config/boot/factory_reset 2>/dev/null)" != 1 ] || grow=0
    [ "$grow" = 0 ] || findmnt -rn -M "$data" >/dev/null || /usr/libexec/muos-run-bounded 30 /usr/libexec/muos-grow-p3 part || :
    n=0; while [ ! -b "$(part 3)" ] && [ "$n" -lt 50 ]; do sleep 0.1; n=$((n+1)); done
    findmnt -rn -M "$data" >/dev/null || mount_p3 || exit 1
    findmnt -rn -M /boot >/dev/null ||
        mount -t vfat -o ro,nosuid,nodev,noexec "$(part 1)" /boot || echo 'data: p1 not mounted'
    # M13: the format the first boot's Install asked for (p3 is unmounted,
    # formatted and mounted again inside; on any failure p3 is ext4 again
    # with the first boot's settings, and the first boot comes back)
    if [ -f "$data/MUOS/port/install-storage" ]; then
        /usr/libexec/muos-install-storage apply || echo 'data: install-storage failed (see MUOS/log/install-storage.log)'
        findmnt -rn -M "$data" >/dev/null || mount_p3 || exit 1
        mkdir -p "$data/MUOS/log"
        cat /run/muos-install-storage.log >> "$data/MUOS/log/install-storage.log" 2>/dev/null && rm -f /run/muos-install-storage.log
    fi
    # M13: a model chosen on a PC (p1 model.txt) switches here, seconds after
    # power-on, not once the menu is up (the first start of a new card runs
    # the port's Panel 0 DTB, black on other panels): armed, p1 and p3 are
    # unmounted and the device restarts into it at once.
    if [ -f /boot/model.txt ]; then
        MUOS_MODEL_EARLY=1 /usr/libexec/muos-model check; rc=$?
        if [ "$rc" = 10 ]; then
            echo 'data: model armed: restarting'; sync
            umount /boot; umount "$data"; reboot -f
        fi
    fi
    mkdir -p "$data/MUOS/log" "$data/ROMS"
    [ -z "$fsck" ] || printf '%s\n' "$fsck" > "$data/MUOS/log/fsck-p3.log"
    # M4b: an oops/panic of the previous boot (ramoops, kept across the warm
    # reboot that panic=10 does) goes to p3 MUOS/log/pstore/<time>/.
    if mount -t pstore pstore /sys/fs/pstore 2>/dev/null || findmnt -rn /sys/fs/pstore >/dev/null; then
        set -- /sys/fs/pstore/dmesg-*
        if [ -e "$1" ]; then
            d=$data/MUOS/log/pstore/$(date +%Y%m%d-%H%M%S)
            mkdir -p "$d" && cp "$@" "$d/" && rm -f "$@" && echo "data: kernel crash log saved to $d"
        fi
    fi
    [ "$grow" = 0 ] || /usr/libexec/muos-grow-p3 fs || :
    ;;
 stop)
    if findmnt -rn -M "$data" >/dev/null; then
        cp /run/muos-rc.log "$data/MUOS/log/rc-last.log" 2>/dev/null || :
        # M4e: the Wi-Fi side of the boot for later diagnosis (worker and
        # udev hotplug logs, the dongle's kernel lines; no secrets: those
        # stay in /run/muos/network/private).
        { echo "== worker"; cat /run/muos/network/worker.log; echo "== hotplug"; cat /run/muos-hotplug.log
          echo "== dmesg"; dmesg | grep -E 'usb 1-1|RTW|8821|wlan0|dwc2'
        } > "$data/MUOS/log/network-last.log" 2>/dev/null || :
        sync
        umount "$data" || { echo 'data: busy, remounting ro'; mount -o remount,ro "$data"; }
    fi
    ! findmnt -rn -M /boot >/dev/null || umount /boot || :
    ;;
 status) findmnt -rn -M "$data" -o OPTIONS | tr ',' '\n' | grep -qx rw ;;
 *) echo 'Usage: S89muos-data start|stop|status' >&2; exit 2 ;;
esac
