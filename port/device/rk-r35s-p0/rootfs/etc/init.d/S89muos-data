#!/bin/sh
# SPDX-License-Identifier: MIT
# Mount p3 (MUOSDATA, ext4) rw at /userdata and p1 (FAT) ro at /boot.
# Before mounting, `e2fsck -p` checks p3 (journal replay; a full pass only if
# the filesystem is flagged with errors), bounded to 100 s. Any result still
# mounts p3 so the UI comes up; the outcome is kept in p3 MUOS/log/fsck-p3.log
# (exit 4 = needs a manual fsck, 124 = timed out).
# First boot of a freshly written image: muos-grow-p3 grows p3 to the
# whole card (partition before the mount, ext4 online after it; no-ops
# afterwards; log p3 MUOS/log/grow-p3.log).
# stop: keep the rc log on p3 (MUOS/log/rc-last.log) and the boot's Wi-Fi
# logs (MUOS/log/network-last.log, M4e), sync, unmount.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
disk=/dev/disk/by-partuuid/4d554432
data=/userdata
part() {
    # M5: the slot 1 card by controller (a copy of the image in slot 2 has
    # the same disk id), the by-partuuid link only as a fallback
    d=$(/usr/libexec/muos-boot-disk) && { echo "${d}p$1"; return; }
    echo "$disk-0$1"
}
case "${1:-}" in
 start)
    mkdir -p "$data" /boot
    n=0; while [ ! -b "$(part 3)" ] && [ "$n" -lt 50 ]; do sleep 0.1; n=$((n+1)); done
    fsck=
    findmnt -rn -M "$data" >/dev/null || /usr/libexec/muos-run-bounded 30 /usr/libexec/muos-grow-p3 part || :
    n=0; while [ ! -b "$(part 3)" ] && [ "$n" -lt 50 ]; do sleep 0.1; n=$((n+1)); done
    if ! findmnt -rn -M "$data" >/dev/null && command -v e2fsck >/dev/null; then
        t0=$(cut -d' ' -f1 /proc/uptime)
        out=$(/usr/libexec/muos-run-bounded 100 e2fsck -p "$(part 3)" 2>&1); rc=$?
        fsck="$t0 e2fsck -p rc=$rc took=$(awk -v a="$t0" '{print $1 - a}' /proc/uptime)s
$out"
        case $rc in 0|1) ;; *) echo "data: e2fsck rc=$rc, mounting anyway" ;; esac
    fi
    findmnt -rn -M "$data" >/dev/null ||
        mount -t ext4 -o rw,noatime,nosuid,nodev,data=ordered "$(part 3)" "$data" || exit 1
    findmnt -rn -M /boot >/dev/null ||
        mount -t vfat -o ro,nosuid,nodev,noexec "$(part 1)" /boot || echo 'data: p1 not mounted'
    mkdir -p "$data/MUOS/log" "$data/ROMS"
    [ -z "$fsck" ] || printf '%s\n' "$fsck" > "$data/MUOS/log/fsck-p3.log"
    # M4b: an oops/panic of the previous boot (ramoops, kept across the warm
    # reboot that panic=10 does) goes to p3 MUOS/log/pstore/<time>/.
    if mount -t pstore pstore /sys/fs/pstore 2>/dev/null || findmnt -rn /sys/fs/pstore >/dev/null; then
        set -- /sys/fs/pstore/dmesg-*
        if [ -e "$1" ]; then
            d=$data/MUOS/log/pstore/$(date +%Y%m%d-%H%M%S)
            mkdir -p "$d" && cp "$@" "$d/" && rm -f "$@" && echo "data: kernel crash log saved to $d"
        fi
    fi
    /usr/libexec/muos-grow-p3 fs || :
    ;;
 stop)
    if findmnt -rn -M "$data" >/dev/null; then
        cp /run/muos-rc.log "$data/MUOS/log/rc-last.log" 2>/dev/null || :
        # M4e: the Wi-Fi side of the boot for later diagnosis (worker and
        # udev hotplug logs, the dongle's kernel lines; no secrets: those
        # stay in /run/muos/network/private).
        { echo "== worker"; cat /run/muos/network/worker.log; echo "== hotplug"; cat /run/muos-hotplug.log
          echo "== dmesg"; dmesg | grep -E 'usb 1-1|RTW|8821|wlan0|dwc2'
        } > "$data/MUOS/log/network-last.log" 2>/dev/null || :
        sync
        umount "$data" || { echo 'data: busy, remounting ro'; mount -o remount,ro "$data"; }
    fi
    ! findmnt -rn -M /boot >/dev/null || umount /boot || :
    ;;
 status) findmnt -rn -M "$data" -o OPTIONS | tr ',' '\n' | grep -qx rw ;;
 *) echo 'Usage: S89muos-data start|stop|status' >&2; exit 2 ;;
esac
