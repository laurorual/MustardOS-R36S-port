#!/bin/sh
# SPDX-License-Identifier: MIT
# CPU frequency opt-in: p3 MUOS/port/cpu_max_khz (one of the available
# frequencies, e.g. 1512000) raises the S03 cap; absent or invalid keeps
# 1296 MHz. Remove the file (over SSH or on any PC) to undo an overclock.
p=/sys/devices/system/cpu/cpu0/cpufreq
conf=/userdata/MUOS/port/cpu_max_khz
case "${1:-}" in
 start)
    [ -w "$p/scaling_max_freq" ] || exit 0
    want=1296000
    if [ -r "$conf" ]; then
        v=$(head -n1 "$conf")
        if grep -qw -- "$v" "$p/scaling_available_frequencies"; then want=$v; else echo "cpufreq: ignoring invalid $conf ($v)"; fi
    fi
    max=$(cat "$p/cpuinfo_max_freq"); [ "$want" -le "$max" ] || want=$max
    echo "$want" > "$p/scaling_max_freq"
    echo "cpufreq: max $(cat "$p/scaling_max_freq") kHz, governor $(cat "$p/scaling_governor")" ;;
 stop|status) : ;;
 *) exit 2 ;;
esac
