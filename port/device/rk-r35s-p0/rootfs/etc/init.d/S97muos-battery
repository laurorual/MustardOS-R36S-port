#!/bin/sh
# SPDX-License-Identifier: MIT
# Battery: muOS mubattery (writes /run/muos/battery/{capacity,voltage,
# charging} for the frontend status bar, from device/config/battery/*) and
# muos-lowbattery (upstream lowpower.sh warning overlay + a port addition:
# clean poweroff through init when critically low and not charging), and
# the muos-headphone jack follower, the muos-logcap log size cap and the
# muos-usb-watchdog (M4f: dwc2 missed plug/unplug) (device monitors share
# this service).
state=/run/muos/battery-service
# M4d: one line per boot and per clean stop on p3 (RTC date, %, mV, mA,
# the kernel's boot decision), kept across boots and reflashes of p2, so
# the % after days off can be compared with the % at the last poweroff.
hist=/userdata/MUOS/log/battery-history.log
history() { # EVENT [TEXT]
    [ -d "${hist%/*}" ] || return 0
    b=/sys/class/power_supply/battery
    printf '%s %s %s cap=%s mv=%s ma=%s %s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" \
        "$(cut -c1-8 /proc/sys/kernel/random/boot_id)" "$(cat $b/capacity 2>/dev/null)" \
        "$(( $(cat $b/voltage_now 2>/dev/null || echo 0) / 1000 ))" \
        "$(( $(cat $b/current_now 2>/dev/null || echo 0) / 1000 ))" "$(cat $b/status 2>/dev/null)" "${2:-}" >> "$hist"
    [ "$(wc -l < "$hist")" -le 600 ] || { tail -n 400 "$hist" > "$hist.tmp" && mv -f "$hist.tmp" "$hist"; }
}
case "${1:-}" in
 start)
    mkdir -p "$state"
    start-stop-daemon -S -b -m -p "$state/hp.pid" -x /bin/sh -- -c 'exec /usr/libexec/muos-headphone >> /opt/muos/log/headphone.log 2>&1'
    start-stop-daemon -S -b -m -p "$state/logcap.pid" -x /usr/libexec/muos-logcap
    start-stop-daemon -S -b -m -p "$state/usbwd.pid" -x /bin/sh -- -c 'exec /usr/libexec/muos-usb-watchdog >> /opt/muos/log/usb-watchdog.log 2>&1'
    /usr/libexec/muos-rumble-setup boot || : # M4e: rumble motor verdict
    /opt/muos/script/mux/tweak.sh boot || : # M4f: audio/max from Audio overdrive
    [ -n "$(cat /opt/muos/device/config/battery/capacity 2>/dev/null)" ] || { echo 'battery: not configured'; exit 0; }
    start-stop-daemon -S -b -m -p "$state/mubattery.pid" -x /opt/muos/frontend/mubattery
    start-stop-daemon -S -b -m -p "$state/low.pid" -x /bin/sh -- -c 'exec /usr/libexec/muos-lowbattery >> /opt/muos/log/battery-port.log 2>&1'
    # The kernel's boot-time gauge decision (port kernel patch 0002).
    dmesg | sed -n 's/.*\(muos-gauge: .*\)/\1/p' | while read -r l; do
        echo "boot $(cat /proc/sys/kernel/random/boot_id | cut -c1-8) $l"; done >> /opt/muos/log/battery-port.log
    history boot "$(dmesg | sed -n 's/.*muos-gauge: boot \(.*\)/\1/p' | tail -n 1)"
    echo "battery: started ($(cat /sys/class/power_supply/battery/capacity)%)" ;;
 stop)
    history stop
    start-stop-daemon -K -q -p "$state/hp.pid" 2>/dev/null || :
    start-stop-daemon -K -q -p "$state/logcap.pid" 2>/dev/null || :
    start-stop-daemon -K -q -p "$state/usbwd.pid" 2>/dev/null || :
    start-stop-daemon -K -q -p "$state/low.pid" 2>/dev/null || :
    start-stop-daemon -K -q -p "$state/mubattery.pid" 2>/dev/null || :
    rm -f "$state"/*.pid ;;
 status) [ -s "$state/mubattery.pid" ] && kill -0 "$(cat "$state/mubattery.pid")" 2>/dev/null ;;
 *) echo 'Usage: S97muos-battery start|stop|status' >&2; exit 2 ;;
esac
