#!/bin/sh
# SPDX-License-Identifier: MIT
# muOS UI service: runs the frontend loop (usr/libexec/muos-frontend) as its
# own session so stop can signal the whole group (frontend, muxretro,
# muhotkey and helpers). Disabled by enabled=0 in /etc/default/muos-ui or by
# a /boot/muos-noui flag file on the FAT partition (safe mode: SSH only).
export PATH=/opt/muos/frontend:/opt/muos/bin:/usr/sbin:/usr/bin:/sbin:/bin
state=/run/muos/ui
loop=/usr/libexec/muos-frontend
enabled=0
hotkeys=1
[ ! -r /etc/default/muos-ui ] || . /etc/default/muos-ui
mkdir -p "$state"
running() { [ -s "$state/loop.pid" ] && kill -0 "$(cat "$state/loop.pid")" 2>/dev/null; }
case "${1:-}" in
 start)
    [ "$enabled" = 1 ] || { echo 'ui: disabled in /etc/default/muos-ui'; exit 0; }
    [ ! -e /boot/muos-noui ] || { echo 'ui: safe mode (/boot/muos-noui)'; exit 0; }
    running && exit 0
    /etc/init.d/S96muos-input-ready status || echo 'ui: warning: input not ready'
    /opt/muos/script/system/assign.sh > "$state/assign.log" 2>&1 || echo 'ui: assign.sh failed'
    audio=dummy; [ ! -e /run/muos/core/audio ] || audio=pipewire
    start-stop-daemon -S -b -m -p "$state/loop.pid" -x /bin/sh -- "$loop" "$hotkeys" "$audio"
    n=0; while [ "$n" -lt 100 ] && [ ! -s /run/muos/first_paint ]; do sleep 0.1; n=$((n+1)); done
    [ -s /run/muos/first_paint ] && echo 'ui: first paint' || echo 'ui: no first paint after 10 s'
    ;;
 stop)
    running || exit 0
    pid=$(cat "$state/loop.pid")
    # start-stop-daemon -b double-forks: the group leader is not $pid.
    group=$(cut -d' ' -f5 "/proc/$pid/stat")
    case "$group" in ''|*[!0-9]*|0|1) group=$pid ;; esac
    kill -TERM "-$group" 2>/dev/null || kill -TERM "$pid"
    n=0; while kill -0 "-$group" 2>/dev/null && [ "$n" -lt 100 ]; do sleep 0.1; n=$((n+1)); done
    kill -KILL "-$group" 2>/dev/null || :
    rm -f "$state/loop.pid"
    sync
    ;;
 status) running ;;
 *) echo 'Usage: S99muos-ui start|stop|status' >&2; exit 2 ;;
esac
