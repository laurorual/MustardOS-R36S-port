#!/bin/sh
# SPDX-License-Identifier: MIT
# Bring-up UI service, separate from upstream install/power/content dispatch.
set -eu
export HOME=/root XDG_RUNTIME_DIR=/run PIPEWIRE_RUNTIME_DIR=/run LC_ALL=C.UTF-8
export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket
export PATH=/opt/muos/frontend:/opt/muos/bin:/usr/sbin:/usr/bin:/sbin:/bin
export SDL_JOYSTICK_HIDAPI=0 SDL_VIDEODRIVER=KMSDRM
export SDL_VIDEO_EGL_DRIVER=libEGL.so SDL_VIDEO_GL_DRIVER=libGLESv2.so
export LD_BIND_NOW=1 LD_LIBRARY_PATH=/opt/muos/frontend/lib
state=/run/muos/ui
enabled=0
hotkeys=1
[ ! -r /etc/default/muos-ui ] || . /etc/default/muos-ui
case "$enabled:$hotkeys" in 0:0|0:1|1:0|1:1) ;; *) exit 2 ;; esac
mkdir -p "$state"
exec 9>"$state/service.lock"
flock -x 9
manager=/usr/libexec/muos-ui-supervisor
case "${1:-}" in
 start)
    [ "$enabled" = 1 ] || exit 0
    if "$manager" --status; then exit 0; fi
    /etc/init.d/S96muos-input-ready status
    mkdir -p /mnt/mmc/MUOS/log /mnt/mmc/ROMS
    /opt/muos/script/system/assign.sh
    if [ -e /run/muos/core/audio ]; then export SDL_AUDIODRIVER=pipewire; else export SDL_AUDIODRIVER=dummy; fi
    rm -f "$state/ready" "$state/failed"
    # Close the service flock in the child: it belongs to this invocation only.
    ( exec 9>&-; exec start-stop-daemon -S -b -x "$manager" -- "$hotkeys" )
    count=0
    while [ "$count" -lt 140 ]; do
        "$manager" --status && exit 0
        [ ! -e "$state/failed" ] || break
        sleep 0.1
        count=$((count + 1))
    done
    "$manager" --stop || :
    echo 'muOS UI: startup failed; see /run/muos/ui' >&2
    exit 1
    ;;
 stop) "$manager" --stop ;;
 status) "$manager" --status ;;
 *) echo 'Usage: S99muos-ui start|stop|status' >&2; exit 2 ;;
esac
