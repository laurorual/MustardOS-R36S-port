// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/* Only for R36S-V12 2023-08-18 Panel 0. Not yet boot-tested.
 * Includes the pinned GPL-2.0+/MIT Hardkernel-derived R35S description.
 * Panel/input/battery values were compared with the installed DTB.
 * Keep the base CPU/GPU OPPs and voltage limits; no dArkOSen overclock.
 */
#include "rk3326-r35s-linux.dts"

/ {
    model = "R36S-V12 2023-08-18 Panel 0";
};

&timing0 {
    clock-frequency = <29000000>;
    hfront-porch = <46>;
    hsync-len = <2>;
    hback-porch = <44>;
    vfront-porch = <165>;
    vsync-len = <2>;
    vback-porch = <14>;
};

&dsi {
    panel@0 {
        display-timings {
            /delete-node/ 50Hz;
            /delete-node/ 75Hz;
            /* M3d: the rk351 r35s timing (29 MHz, v 165/2/14) let the bottom
             * rows show the top rows, intermittently and persisting once
             * started (seen 2026-11-12). The ST7703 init (b3 SETRGBIF) expects short
             * vertical porches: use the stock dArkOSen Panel 0 vertical
             * timing and pixel clock (50 MHz, v 17/5/13, as ROCKNIX), with
             * horizontal porches widened from 450 to 466 so that
             * 50 MHz / (1618 x 515) = 60.0046 Hz instead of stock 61.2 Hz
             * (device/config/screen/refresh says 60.004560 to match). */
            60Hz {
                clock-frequency = <50000000>;
                hfront-porch = <466>;
                hsync-len = <46>;
                hback-porch = <466>;
                vfront-porch = <17>;
                vsync-len = <5>;
                vback-porch = <13>;
            };
        };
    };
};

&joypad {
    button-adc-deadzone = <384>;
};

&rk817 {
    battery {
        /* These describe the reference DTB, not a measured cell capacity. */
        ocv_table = <3400 3442 3494 3537 3574 3604 3633
                     3666 3697 3726 3760 3790 3812 3842
                     3886 3928 3955 3990 4036 4105 4177>;
        design_capacity = <3140>;
        design_qmax = <3454>;
    };
    charger {
        /delete-property/ bat_low_gpio;
    };
};

&leds {
    status = "disabled";
};
