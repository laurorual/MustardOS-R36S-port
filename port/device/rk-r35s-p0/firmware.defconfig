# M3a firmware: the whole p2 rootfs from one Buildroot build.
# Derived by savedefconfig from the Phase 4 graphics + network config
# (build/phase4/network-tools/resolved.config) that produced the live p2.
# build-image.sh stages /m3a/overlay (port rootfs, symlinks resolved) and
# installs the SHA256-pinned prebuilt inputs (firmware-inputs.json) post-build.
BR2_aarch64=y
BR2_cortex_a35=y
BR2_KERNEL_HEADERS_CUSTOM_TARBALL=y
BR2_KERNEL_HEADERS_CUSTOM_TARBALL_LOCATION="https://github.com/christianhaitian/linux/archive/d8402159c04b1044106b4f27b7ed7c22ed09228f.tar.gz"
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_4_4=y
BR2_PACKAGE_HOST_LINUX_HEADERS_LICENSE_FILES="COPYING"
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_PACKAGE_OVERRIDE_FILE="/port/packaging/phase4-private-provider.mk"
BR2_GLOBAL_PATCH_DIR="/port/patches/phase4-graphics"
BR2_REPRODUCIBLE=y
BR2_TARGET_GENERIC_HOSTNAME="muos-r35s"
BR2_TARGET_GENERIC_ISSUE="MustardOS for R36S/R35S (unofficial port)"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyFIQ0"
BR2_ROOTFS_OVERLAY="/m3a/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="/port/scripts/firmware-post-build.sh"
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="/port/device/rk-r35s-p0/phase4-foundation.busybox"
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
# M4d: time zones for the menu's Timezone screen (/etc/localtime is set
# by firmware-post-build.sh).
BR2_TARGET_TZ_INFO=y
BR2_TARGET_LOCALTIME=""
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_FFMPEG=y
# BR2_PACKAGE_FFMPEG_FFMPEG is not set
BR2_PACKAGE_FFMPEG_SWSCALE=y
BR2_PACKAGE_FFMPEG_ENCODERS=""
BR2_PACKAGE_FFMPEG_DECODERS="png mjpeg h264"
BR2_PACKAGE_FFMPEG_MUXERS=""
BR2_PACKAGE_FFMPEG_DEMUXERS="image2 mov"
BR2_PACKAGE_FFMPEG_PARSERS="h264"
BR2_PACKAGE_FFMPEG_BSFS=""
BR2_PACKAGE_FFMPEG_PROTOCOLS="file"
BR2_PACKAGE_FFMPEG_FILTERS=""
BR2_PACKAGE_PIPEWIRE=y
BR2_PACKAGE_WIREPLUMBER=y
BR2_PACKAGE_SDL2=y
BR2_PACKAGE_SDL2_KMSDRM=y
BR2_PACKAGE_SDL2_OPENGLES=y
BR2_PACKAGE_SDL2_IMAGE=y
BR2_PACKAGE_JPEG=y
BR2_PACKAGE_SDL2_MIXER=y
BR2_PACKAGE_SDL2_TTF=y
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_ROCKCHIP_MALI=y
BR2_PACKAGE_USB_MODESWITCH=y
BR2_PACKAGE_LUA=y
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_PYC_ONLY=y
BR2_PACKAGE_PYTHON3_BZIP2=y
BR2_PACKAGE_PYTHON3_DECIMAL=y
BR2_PACKAGE_PYTHON3_PYEXPAT=y
BR2_PACKAGE_PYTHON3_SSL=y
BR2_PACKAGE_PYTHON3_XZ=y
BR2_PACKAGE_PYTHON3_ZLIB=y
BR2_PACKAGE_LIBARCHIVE=y
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_HARFBUZZ=y
BR2_PACKAGE_LIBPNG=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_WGET=y
# M5: CA bundle for libcurl (/etc/ssl/certs/ca-certificates.crt): the
# frontend's HTTPS fetches (theme download, news) failed without it
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_DROPBEAR=y
# BR2_PACKAGE_DROPBEAR_CLIENT is not set
BR2_PACKAGE_DROPBEAR_DISABLE_REVERSEDNS=y
# M3c: SFTP for dropbear (/usr/libexec/sftp-server; also serves OpenSSH scp)
BR2_PACKAGE_GESFTPSERVER=y
# M5: Info-ZIP zip/unzip for muOS extract.sh/backup.sh (unzip -Z; BusyBox unzip lacks it)
BR2_PACKAGE_UNZIP=y
BR2_PACKAGE_ZIP=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_WEXT=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_BASH=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_MOUNT=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
BR2_PACKAGE_ZSTD=y
BR2_PACKAGE_LIBVORBIS=y
BR2_PACKAGE_OPENAL=y
BR2_PACKAGE_LIBMODPLUG=y
BR2_PACKAGE_LIBSNDFILE=y
BR2_PACKAGE_SDL2_GFX=y
BR2_PACKAGE_SDL2_NET=y
BR2_PACKAGE_FONTCONFIG=y
BR2_PACKAGE_MPG123=y
BR2_PACKAGE_OPUSFILE=y
BR2_PACKAGE_LIBEVDEV=y
BR2_PACKAGE_LIBZIP=y
BR2_PACKAGE_LIBXML2=y
BR2_PACKAGE_SPEEX=y
BR2_PACKAGE_PULSEAUDIO=y
BR2_PACKAGE_EXFATPROGS=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FATLABEL=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_LABEL="ROOTFS"
BR2_TARGET_ROOTFS_EXT2_SIZE="1G"
BR2_TARGET_ROOTFS_EXT2_MKFS_OPTIONS="-O ^64bit,^orphan_file,^metadata_csum_seed,^fast_commit"
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_KMOD=y
BR2_PACKAGE_MUOS_CORE=y
BR2_PACKAGE_MUOS_R35S_WIFI_ONLY=y
BR2_PACKAGE_MUOS_SDL_AUDIO_PROBE=y
BR2_PACKAGE_MUOS_BOOTREC=y
BR2_PACKAGE_MUOS_RUMBLE=y
# M4g: SFTP jail (static sftp-server, muos account, musftpjail modes)
BR2_PACKAGE_MUOS_SFTP_STATIC=y
