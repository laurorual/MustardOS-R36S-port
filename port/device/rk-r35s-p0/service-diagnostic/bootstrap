#!/bin/sh
# SPDX-License-Identifier: MIT
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
[ "$$" = 1 ] || { echo 'Bootstrap requires PID 1' >&2; exit 64; }
fail() {
    printf '\033[37;40m\033[2J\033[HmuOS C01: STOPPED\n%s\n' "$1" > /dev/tty0
    while :; do sleep 3600; done
}
mount -t proc proc /proc || fail 'proc mount failed'
mount -t sysfs sysfs /sys || fail 'sysfs mount failed'
[ "$(uname -r)" = 4.4.189-muos-r35s-p4 ] || fail 'Wrong kernel'
[ "$(cat /etc/muos-services-diagnostic)" = MUOS-R35S-INIT-P4-C01 ] || fail 'C01 marker missing'
[ "$(tr -d '\000' < /sys/firmware/devicetree/base/model)" = 'R36S-V12 2023-08-18 Panel 0' ] || fail 'Wrong model'
. /usr/libexec/muos-diag-card-guard
boot=$(diag_card /sys) || fail 'Protected card present or test card missing'
root=${boot%p1}p2
[ "$(findmnt -rn -o MAJ:MIN /)" = "$(cat /sys/class/block/${root##*/}/dev)" ] || fail 'Root identity mismatch'
[ "$(findmnt -rn -o FSTYPE /)" = ext4 ] || fail 'Wrong filesystem'
findmnt -rn -o OPTIONS / | tr ',' '\n' | grep -qx ro || fail 'Initial root must be ro'
grep -qx enabled=0 /etc/default/muos-ui || fail 'UI must be disabled'
grep -qx audio=0 /etc/default/muos-core || fail 'Audio must be disabled'
for usb in /sys/bus/usb/devices/*; do
    [ -r "$usb/idVendor" ] && [ -r "$usb/idProduct" ] || continue
    if [ "$(cat "$usb/idVendor"):$(cat "$usb/idProduct")" = 0bda:c820 ]; then
        fail 'Remove Wi-Fi dongle for the C01 test'
    fi
done
printf '\033[37;40m\033[2J\033[HmuOS - R35S / Panel 0\nC01: starting BusyBox init...\n' > /dev/tty0
exec /sbin/init
